{
  "name": "electron-core-ui",
  "version": "0.1.2",
  "description": "A generic Electron + React foundation with VSCode-like UI components and services",
  "main": "dist/src/main/index.js",
  "types": "dist/src/main/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/main/index.d.ts",
      "default": "./dist/src/main/index.js"
    },
    "./main": {
      "types": "./dist/src/main/index.d.ts",
      "default": "./dist/src/main/index.js"
    },
    "./renderer": {
      "types": "./dist/src/renderer/index.d.ts",
      "default": "./dist/src/renderer/index.js"
    },
    "./preload": {
      "types": "./dist/src/preload/index.d.ts",
      "default": "./dist/src/preload/index.js"
    },
    "./preload/api": {
      "types": "./dist/src/preload/api.d.ts",
      "default": "./dist/src/preload/api.js"
    },
    "./preload/electronAPI": {
      "types": "./dist/src/preload/electronAPI.d.ts",
      "default": "./dist/src/preload/electronAPI.js"
    },
    "./types": {
      "types": "./types/index.d.ts",
      "default": "./types/index.d.ts"
    },
    "./types/*": "./types/*",
    "./fonts.css": "./fonts.css",
    "./resources/fonts/*": "./resources/fonts/*"
  },
  "files": [
    "dist",
    "types",
    "resources",
    "fonts.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:main && npm run build:renderer && npm run merge-dist",
    "build:main": "tsc --project tsconfig.main.json",
    "build:renderer": "tsc --project tsconfig.renderer.json",
    "merge-dist": "node scripts/merge-dist.js",
    "dev": "tsc --project tsconfig.main.json --watch & tsc --project tsconfig.renderer.json --watch",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "electron",
    "react",
    "vscode",
    "ui",
    "theme",
    "foundation",
    "boilerplate"
  ],
  "author": {
    "name": "Yoann Diguet",
    "email": "contact@oyo-fr.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "@milkdown/crepe": "^7.17.2",
    "@milkdown/kit": "^7.17.2",
    "@milkdown/react": "^7.3.2",
    "@monaco-editor/react": "^4.7.0",
    "electron": "^28.0.0",
    "monaco-editor": "^0.54.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@milkdown/plugin-listener": "^7.17.3",
    "@vscode/codicons": "^0.0.41",
    "ag-grid-community": "^34.3.1",
    "ag-grid-react": "^34.3.1",
    "handlebars": "^4.7.7",
    "highlight.js": "^11.11.1",
    "i18next": "^23.7.6",
    "js-yaml": "^4.1.0",
    "mermaid": "^10.9.0",
    "minisearch": "^7.2.0",
    "react-i18next": "^13.5.0",
    "react-icons": "^4.12.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "electron": "^28.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "monaco-editor": "^0.54.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.0"
  }
}
