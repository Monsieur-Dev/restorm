{
  "name": "electron-core-ui",
  "version": "0.1.2",
  "description": "A generic Electron + React foundation with UI components and services",
  "main": "dist/src/main/index.js",
  "types": "dist/src/main/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/main/index.d.ts",
      "default": "./dist/src/main/index.js"
    },
    "./main": {
      "types": "./dist/src/main/index.d.ts",
      "default": "./dist/src/main/index.js"
    },
    "./decorators": {
      "types": "./dist/src/main/decorators/index.d.ts",
      "default": "./dist/src/main/decorators/index.js"
    },
    "./testing": {
      "types": "./dist/src/main/testing/index.d.ts",
      "default": "./dist/src/main/testing/index.js"
    },
    "./testing/playwright-bdd": {
      "types": "./dist/src/main/testing/playwright-bdd/index.d.ts",
      "default": "./dist/src/main/testing/playwright-bdd/index.js"
    },
    "./renderer": {
      "types": "./dist/src/renderer/index.d.ts",
      "default": "./dist/src/renderer/index.js"
    },
    "./preload": {
      "types": "./dist/src/preload/index.d.ts",
      "default": "./dist/src/preload/index.js"
    },
    "./preload/api": {
      "types": "./dist/src/preload/api.d.ts",
      "default": "./dist/src/preload/api.js"
    },
    "./preload/electronAPI": {
      "types": "./dist/src/preload/electronAPI.d.ts",
      "default": "./dist/src/preload/electronAPI.js"
    },
    "./types": {
      "types": "./dist/src/types/index.d.ts",
      "default": "./dist/src/types/index.js"
    },
    "./types/*": {
      "types": "./dist/src/types/*.d.ts",
      "default": "./dist/src/types/*.js"
    },
    "./fonts.css": "./fonts.css",
    "./resources/fonts/*": "./resources/fonts/*"
  },
  "files": [
    "dist",
    "resources",
    "fonts.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer && pnpm run merge-dist",
    "build:main": "tsc --project tsconfig.main.json",
    "build:renderer": "tsc --project tsconfig.renderer.json",
    "merge-dist": "node scripts/merge-dist.js",
    "dev": "tsc --project tsconfig.main.json --watch & tsc --project tsconfig.renderer.json --watch",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "depcheck": "depcheck",
    "validate:contrast": "node scripts/validate-contrast.js"
  },
  "keywords": [
    "electron",
    "react",
    "ui",
    "theme",
    "foundation",
    "boilerplate"
  ],
  "author": {
    "name": "Yoann Diguet",
    "email": "contact@restorm.app"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/react": "^7.22.0",
    "@monaco-editor/react": "^4.7.0",
    "electron": "^42.1.0",
    "monaco-editor": "^0.54.0",
    "react": "^19.0.5",
    "react-dom": "^19.0.5"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@graphql-yoga/subscription": "^5.1.1",
    "@mdi/js": "^7.4.47",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paper-design/shaders-react": "^0.0.80",
    "@phosphor-icons/react": "^2.1.10",
    "@tsparticles/engine": "^4.5.1",
    "@tsparticles/react": "^4.5.1",
    "@tsparticles/slim": "^4.5.1",
    "@uiw/react-color": "^2.10.3",
    "@vscode/codicons": "0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "chokidar": "^5.0.0",
    "cobe": "^2.0.1",
    "fast-xml-parser": "^4.5.7",
    "graphql": "^16.15.0",
    "graphql-sse": "^2.6.3",
    "graphql-yoga": "^6.0.1",
    "handlebars": "^4.7.10",
    "i18next": "^26.7.1",
    "iconoir-react": "^7.12.2",
    "jose": "^6.2.15",
    "js-yaml": "^5.5.0",
    "json5": "^2.2.3",
    "lottie-react": "^2.4.2",
    "luxon": "^3.7.2",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "motion": "^13.5.1",
    "react-feather": "^2.0.10",
    "react-i18next": "^17.1.12",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "simple-icons": "^16.36.0",
    "simplex-noise": "^4.0.3",
    "unique-names-generator": "^4.7.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@monaco-editor/react": "^4.7.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^43.8.7",
    "eslint": "^9.39.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "monaco-editor": "^0.56.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.58.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
