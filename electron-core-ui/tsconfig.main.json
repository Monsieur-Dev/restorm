{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist-main",
    "rootDir": "."
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/types/**/*",
    "src/errors/**/*"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
