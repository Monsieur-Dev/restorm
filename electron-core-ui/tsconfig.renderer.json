{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist-renderer",
    "rootDir": "."
  },
  "include": [
    "src/renderer/**/*",
    "src/types/**/*",
    "src/errors/**/*"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
