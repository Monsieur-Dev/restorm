{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VSCode Color Theme (extended)",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["dark", "light", "hc", "hcLight", "hc-dark", "hc-light"]
    },
    "colors": {
      "type": "object",
      "description": "Color keys for the theme. Extended to allow custom keys such as window.border.",
      "additionalProperties": true
    },
    "tokenColors": {
      "type": "array"
    },
    "semanticTokenColors": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}


