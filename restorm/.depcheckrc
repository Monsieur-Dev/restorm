{
  "ignore_patterns": [
    "tests/e2e/.tmp/**",
    "tests/e2e/.features-gen/**",
    ".features-gen/**"
  ],
  "ignores": [
    "@types/*",
    "typescript",
    "typescript-eslint",
    "@typescript-eslint/*",
    "eslint",
    "eslint-*",
    "globals",
    "cross-env",
    "electron",
    "electron-builder",
    "electron-vite",
    "@vitejs/*",
    "vite",
    "playwright",
    "@playwright/*",
    "vitest",
    "@vitest/*",
    "@testing-library/*",
    "jsdom",
    "@milkdown/*"
  ]
}
