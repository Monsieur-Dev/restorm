collections:
  - folderType: environment
    name: HTTP Execution Playground
    documentation: |-
      # HTTP Execution Playground

      Drives the full HTTP/REST execution matrix end-to-end. Most edge cases
      hit the local `http-util` mock (`http://localhost:8082`): `/echo`,
      `/redirect/:n`, `/status/:code`, `/cookie/set` + `/cookie/echo`,
      `/binary`, `/xml`, `/html`, `/multi-header`, `/slow`. CRUD + multipart
      file upload hit the Docker Petstore (`http://localhost:8080`).
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables:
          - key: petstore
            value:
              type: string
              value: http://localhost:8080
            enabled: true
          - key: util
            value:
              type: string
              value: http://localhost:8082
            enabled: true
          - key: token
            value:
              type: string
              value: env-secret-token
            enabled: true
          - key: petId
            value:
              type: numeric
              value: 1
              format: decimal
            enabled: true
        id: 8c25de44-9643-47e1-b557-af39e245e119
    items:
      - type: http
        name: GET echo
        tags: []
        method: GET
        url: '{{util}}/echo'
        headers: []
        params: []
        pathParams: []
        id: 330f3c58-6460-4229-b14f-05592a578697
      - type: http
        name: POST echo
        tags: []
        method: POST
        url: '{{util}}/echo'
        headers: []
        params: []
        pathParams: []
        body:
          type: text
          content: '{"hello":"world"}'
        id: cec0db3c-31b6-4988-b2d7-11efa709dbe9
      - type: http
        name: PUT echo
        tags: []
        method: PUT
        url: '{{util}}/echo'
        headers: []
        params: []
        pathParams: []
        body:
          type: text
          content: '{"put":true}'
        id: 1fd5dc3e-30b1-4bf0-9b03-2a757ea9871a
      - type: http
        name: PATCH echo
        tags: []
        method: PATCH
        url: '{{util}}/echo'
        headers: []
        params: []
        pathParams: []
        body:
          type: text
          content: '{"patch":true}'
        id: f0711f41-5786-4425-b525-3fa3433725a0
      - type: http
        name: DELETE echo
        tags: []
        method: DELETE
        url: '{{util}}/echo'
        headers: []
        params: []
        pathParams: []
        id: 4cfda044-92a5-4607-bd54-def4c50e5b39
      - type: http
        name: HEAD echo
        tags: []
        method: HEAD
        url: '{{util}}/echo'
        headers: []
        params: []
        pathParams: []
        id: b8983513-a85d-4d11-bac5-c0c8ed30dd3a
      - type: http
        name: OPTIONS echo
        tags: []
        method: OPTIONS
        url: '{{util}}/echo'
        headers: []
        params: []
        pathParams: []
        id: 40dbe742-6d18-4891-a4ba-df29d2d4a232
      - type: http
        name: Query params
        tags: []
        method: GET
        url: '{{util}}/echo'
        headers: []
        params:
          - key: q
            value:
              type: string
              value: hello world
            enabled: true
          - key: tag
            value:
              type: string
              value: a
            enabled: true
        pathParams: []
        id: dd925d09-607b-4848-9d3e-f99f5f6d488e
      - type: http
        name: Path param
        tags: []
        method: GET
        url: '{{petstore}}/api/pet/{{petId}}'
        headers:
          - key: Accept
            value:
              type: string
              value: application/json
            enabled: true
        params: []
        pathParams:
          - key: petId
            value:
              type: string
              value: '1'
            enabled: true
        id: 50db2603-6c7c-4184-b68d-9ebc28b3e8af
      - type: http
        name: Form urlencoded
        tags: []
        method: POST
        url: '{{util}}/echo'
        headers: []
