            enabled: true
        params: []
        pathParams: []
        id: a6f964e0-141b-420c-93ce-5cfd750293c0
      - type: http
        name: API key in query
        tags: []
        method: GET
        url: '{{util}}/echo'
        headers: []
        params:
          - key: api_key
            value:
              type: string
              value: special-key
            enabled: true
        pathParams: []
        id: ee227f60-2dd6-46cd-896c-e1e993767bc0
      - type: http
