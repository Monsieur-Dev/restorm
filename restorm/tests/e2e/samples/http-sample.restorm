        body:
          type: x-www-form-urlencoded
          fields:
            - key: user
              value:
                type: string
                value: alice
              enabled: true
            - key: pass
              value:
                type: string
                value: s3cret
              enabled: true
        id: e21322c0-a5bc-4865-b507-44c5c07d4ebf
      - type: http
        name: Raw text
        tags: []
        method: POST
        url: '{{util}}/echo'
        headers:
          - key: Content-Type
            value:
              type: string
              value: text/plain
            enabled: true
        params: []
        pathParams: []
        body:
          type: text
          content: just some raw text
        id: 56277666-6b1f-48ad-b94e-80127e8230ef
      - type: http
