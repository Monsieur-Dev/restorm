collections:
  - folderType: environment
    fileFormatVersion: 1
    name: OData Typing
    documentation: ''
    tags:
      - odata
    id: b0000000-0000-0000-0000-00000000beef
    environments:
      - name: localhost
        variables:
          - key: baseUrl
            value:
              type: string
              value: http://example.test/odata
            enabled: true
    items:
      - name: People
        documentation: ''
        tags: []
        configuration: {}
        id: f0000000-0000-0000-0000-00000000beef
        items:
          - type: odata
            name: List People
            documentation: ''
            tags:
              - odata
            id: d0000000-0000-0000-0000-00000000beef
            url: '{{baseUrl}}/People'
            odataVersion: v4
            operationKind: entity-set
            headers:
              - key: Accept
                value: application/json
                enabled: true
            params: []
            queryOptions: {}
            entitySetProperties:
              - Id
              - Name
              - Email
            navigationProperties: []
