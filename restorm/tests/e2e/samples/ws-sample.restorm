collections:
  - folderType: environment
    name: WebSocket Playground
    documentation: |-
      # WebSocket Playground

      Connects to the local raw WebSocket echo server (docker-compose service
      `ws-echo`, exposed on port 3002). Send a JSON payload and observe the
      server echo it straight back. Unlike Socket.IO there are no named events
      or acknowledgements — every received frame is a plain message.

      The plain HTTP `/push` route pushes a frame to every connected client, so
      an external trigger can deliver a server→client message.
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables: []
        id: fed4ba93-ea01-4844-bb88-cc03264379f0
    items:
      - type: websocket
        name: WS Echo
        documentation: Send a payload and receive the same frame echoed back.
        tags:
          - websocket
        url: ws://localhost:3002
        protocol: websocket
        message: |-
          {
            "hello": "world"
          }
        headers: []
        id: a8d16c1c-879f-4acd-834c-c5d2092e967e
      - type: http
        name: Push to WS echo (HTTP)
        documentation: |-
          # Push to WS echo (HTTP)

          Calls the mock's plain HTTP route `/push` to send a frame to every
          connected client. Connect **WS Echo** first, then run this — the
          pushed payload appears in WS Echo's stream.
        tags:
          - http
          - trigger
        method: GET
        url: http://localhost:3002/push
        headers: []
        params:
          - key: data
            value:
              type: string
              value: '{"hello":"from HTTP"}'
            description: Raw frame to push to listeners
        pathParams: []
        id: 0a932ed1-13d0-45a7-85ee-4a69f137de42
    id: 7cebefcd-058c-41ad-946e-8e3b2cf6ba39
    fileFormatVersion: 1
_projectUuid: 87743c3c-74c8-408c-b00d-a22338ddc23e
