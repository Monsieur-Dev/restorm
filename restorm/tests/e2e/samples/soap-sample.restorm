fileFormatVersion: 1
collections:
  - id: 18293041-5263-47e8-f901-234567890123
    name: SOAP Playground
    folderType: environment
    configuration: {}
    environments:
      - id: a1b2c3d4-e5f6-4071-8293-a4b5c6d7e8f9
        name: Default
        variables:
          - key: soapBase
            enabled: true
            value:
              type: string
              value: http://localhost:8091/soap
          - key: echoMessage
            enabled: true
            value:
              type: string
              value: hello-handlebars-42
          - key: reqId
            enabled: true
            value:
              type: string
              value: test-request-id-999
    items:
      - id: b2c3d4e5-f607-4182-9304-b5c6d7e8f901
        name: SOAP Echo
        type: soap
        url: http://localhost:8091/soap
        body: |-
          <?xml version="1.0" encoding="UTF-8"?>
          <soap:Envelope
            xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
            xmlns:tns="http://restorm.test/castlemock">
            <soap:Header/>
            <soap:Body>
              <tns:EchoRequest>
                <tns:message>{{echoMessage}}</tns:message>
              </tns:EchoRequest>
            </soap:Body>
          </soap:Envelope>
        documentation: |-
          Sends <message>{{echoMessage}}</message> in the request envelope.
          The mock reflects it back in <EchoResponse>/<message>. Asserting
          the response contains the resolved value (not "{{echoMessage}}")
          proves Handlebars substitution reached the wire.
        headers:
          - key: Content-Type
            description: ''
            enabled: true
            value:
              type: string
              value: text/xml; charset=utf-8
          - key: SOAPAction
            description: ''
            enabled: true
            value:
              type: string
              value: http://restorm.test/castlemock/Echo
          - key: X-Request-Id
            description: ''
            enabled: true
            value:
              type: expression
              value: '{{reqId}}'
        operation: Echo
        service: TestService
        soapAction: http://restorm.test/castlemock/Echo
        tags:
          - soap
          - echo
      - id: c3d4e5f6-0718-4293-a4b5-c6d7e8f90213
        name: SOAP Echo (env URL)
        type: soap
        url: '{{soapBase}}'
        body: |-
          <?xml version="1.0" encoding="UTF-8"?>
          <soap:Envelope
            xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
            xmlns:tns="http://restorm.test/castlemock">
            <soap:Header/>
            <soap:Body>
              <tns:EchoRequest>
                <tns:message>env-url-test</tns:message>
              </tns:EchoRequest>
            </soap:Body>
          </soap:Envelope>
        documentation: |-
          Same Echo operation but the URL comes from the {{soapBase}} env variable.
          Proves URL Handlebars substitution works alongside the body substitution.
        headers:
          - key: Content-Type
            description: ''
            enabled: true
            value:
              type: string
              value: text/xml; charset=utf-8
          - key: SOAPAction
            description: ''
            enabled: true
            value:
              type: string
              value: http://restorm.test/castlemock/Echo
        operation: Echo
        service: TestService
        soapAction: http://restorm.test/castlemock/Echo
        tags:
          - soap
          - echo
          - env
      - id: d4e5f607-1829-43a4-b5c6-d7e8f9012345
        name: SOAP Add (complex type)
        type: soap
        url: http://localhost:8091/soap
        body: |-
          <?xml version="1.0" encoding="UTF-8"?>
          <soap:Envelope
            xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
            xmlns:tns="http://restorm.test/castlemock">
            <soap:Header/>
            <soap:Body>
              <tns:AddRequest>
                <tns:a>7</tns:a>
                <tns:b>3</tns:b>
              </tns:AddRequest>
            </soap:Body>
          </soap:Envelope>
        documentation: |-
          Calculator Add — sends two integer elements (<a> and <b>) and
          asserts the response contains the sum. Exercises complex-type
          (nested element) input.
        headers:
          - key: Content-Type
            description: ''
            enabled: true
            value:
              type: string
              value: text/xml; charset=utf-8
          - key: SOAPAction
            description: ''
            enabled: true
            value:
              type: string
              value: http://restorm.test/castlemock/Add
        operation: Add
        service: TestService
        soapAction: http://restorm.test/castlemock/Add
        tags:
          - soap
          - calculator
      - id: e5f60718-2930-44b5-c6d7-e8f901234567
        name: SOAP Fault
        type: soap
        url: http://localhost:8091/soap
        body: |-
          <?xml version="1.0" encoding="UTF-8"?>
          <soap:Envelope
            xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
            xmlns:tns="http://restorm.test/castlemock">
            <soap:Header/>
            <soap:Body>
              <tns:FaultRequest/>
            </soap:Body>
          </soap:Envelope>
        documentation: |-
          Always triggers a SOAP Fault (faultcode soap:Server, faultstring
          "Fault triggered for testing"). Asserts the fault block is
          surfaced distinctly in the response panel.
        headers:
          - key: Content-Type
            description: ''
            enabled: true
            value:
              type: string
              value: text/xml; charset=utf-8
          - key: SOAPAction
            description: ''
            enabled: true
            value:
              type: string
              value: http://restorm.test/castlemock/Fault
        operation: Fault
        service: TestService
        soapAction: http://restorm.test/castlemock/Fault
        tags:
          - soap
          - fault
      - id: f6071829-3041-45c6-d7e8-f90123456789
        name: SOAP Slow (cancel)
        type: soap
        url: http://localhost:8091/soap
        body: |-
          <?xml version="1.0" encoding="UTF-8"?>
          <soap:Envelope
            xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
            xmlns:tns="http://restorm.test/castlemock">
            <soap:Header/>
            <soap:Body>
              <tns:SlowRequest/>
            </soap:Body>
          </soap:Envelope>
        documentation: |-
          The mock waits 8 seconds before responding. Used by the
          cancellation scenario: click Send, immediately click Cancel,
          and assert the panel returns to the idle state with no result.
        headers:
          - key: Content-Type
            description: ''
            enabled: true
            value:
              type: string
              value: text/xml; charset=utf-8
          - key: SOAPAction
            description: ''
            enabled: true
            value:
              type: string
              value: http://restorm.test/castlemock/Slow
        operation: Slow
        service: TestService
        soapAction: http://restorm.test/castlemock/Slow
        tags:
          - soap
          - cancel
      - id: 07182930-4152-46d7-e8f9-012345678901
        name: SOAP Malformed
        type: soap
        url: http://localhost:8091/soap
        body: |-
          <?xml version="1.0" encoding="UTF-8"?>
          <soap:Envelope
            xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
            xmlns:tns="http://restorm.test/castlemock">
            <soap:Header/>
            <soap:Body>
              <tns:MalformedRequest/>
            </soap:Body>
          </soap:Envelope>
        documentation: |-
          The mock returns a non-XML body ("THIS IS NOT XML…"). Asserts
          the panel surfaces a clean error rather than a blank or crashed
          response area.
        headers:
          - key: Content-Type
            description: ''
            enabled: true
            value:
              type: string
              value: text/xml; charset=utf-8
          - key: SOAPAction
            description: ''
            enabled: true
            value:
              type: string
              value: http://restorm.test/castlemock/Malformed
        operation: Malformed
        service: TestService
        soapAction: http://restorm.test/castlemock/Malformed
        tags:
          - soap
          - malformed
    tagColors: {}
    tags: []
_projectUuid: 29304152-6374-48f9-0123-456789012345
