collections:
  - folderType: environment
    name: Legacy Body Types
    documentation: |-
      A fixture persisted with the legacy camelCase `body.type`
      spellings (`formData` / `xWwwFormUrlEncoded`). Loading it
      exercises the on-load body-type canonicalisation: the app must
      migrate these to the kebab-case `form-data` / `x-www-form-urlencoded`
      vocabulary transparently and without flagging the document dirty.
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables:
          - key: baseUrl
            value:
              type: string
              value: http://localhost:8080
            description: ''
        subEnvironments: []
    items:
      - type: http
        name: Legacy form-data request
        documentation: ''
        tags: []
        method: POST
        url: '{{baseUrl}}/upload'
        headers: []
        params: []
        pathParams: []
        body:
          type: formData
          fields:
            - key: name
              value:
                type: string
                value: doggo
              description: ''
              enabled: true
            - key: status
              value:
                type: string
                value: available
              description: ''
              enabled: true
      - type: http
        name: Legacy urlencoded request
        documentation: ''
        tags: []
        method: POST
        url: '{{baseUrl}}/login'
        headers: []
        params: []
        pathParams: []
        body:
          type: xWwwFormUrlEncoded
          fields:
            - key: username
              value:
                type: string
                value: admin
              description: ''
              enabled: true
            - key: password
              value:
                type: string
                value: secret
              description: ''
              enabled: true
