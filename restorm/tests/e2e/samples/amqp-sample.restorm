fileFormatVersion: 1
collections:
  - folderType: environment
    name: AMQP Playground
    documentation: |-
      # AMQP Playground

      Publish to and consume from a RabbitMQ broker (the `rabbitmq` Docker
      mock — see `tests/docker/docker-compose.yml`). The broker pre-declares
      a durable `restorm-e2e-queue` (via `rabbitmq-definitions.json`); v1 AMQP
      support is read-only (no declare/delete), so both requests target that
      pre-existing queue.

      - **AMQP Publish** publishes to the DEFAULT exchange (empty string)
        with routing key `restorm-e2e-queue` — the default exchange routes
        directly to the queue of the same name, no binding needed.
      - **AMQP Subscribe** connects and consumes `restorm-e2e-queue`.
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables:
          - key: brokerUrl
            value:
              type: string
              value: amqp://guest:guest@localhost:5672/
            description: The Docker-mock RabbitMQ broker
        id: b7e6a1d2-4c8f-4a3b-9e1d-2f6c8a0b3d75
    items:
      - type: amqp
        name: AMQP Publish
        documentation: Publish a payload to `restorm-e2e-queue` via the default exchange.
        tags:
          - amqp
        url: '{{brokerUrl}}'
        mode: publish
        exchange: ''
        routingKey: restorm-e2e-queue
        payload: |-
          {
            "hello": "from amqp"
          }
        id: 3d8b1c4e-6a2f-4d91-8b0e-7c5a4f2e9d18
      - type: amqp
        name: AMQP Subscribe
        documentation: Connect and consume `restorm-e2e-queue`.
        tags:
          - amqp
        url: '{{brokerUrl}}'
        mode: subscribe
        queue: restorm-e2e-queue
        autoAck: true
        id: 8f4e2a1b-9c3d-4e7f-a2b6-1d5c8e0f4a29
    id: e2c9a4d1-6b3f-4a87-9d2e-5c8b1f0a3e67
_projectUuid: c4a9d2e1-7b3f-4a86-9d1e-6c8b0f2a4e58
