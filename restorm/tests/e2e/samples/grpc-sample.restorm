collections:
  - folderType: environment
    name: gRPC Playground
    documentation: |-
      # gRPC Playground

      Connects to the local grpcbin server (docker-compose service `grpc`,
      `moul/grpcbin`, exposed on port 9000). The bundled grpcbin proto descriptor
      resolves the `grpcbin.GRPCBin` service, so no `.proto` import is needed.

      **gRPC Echo (bidi)** opens a bidirectional stream
      (`DummyBidirectionalStreamStream`): each request message you send is echoed
      straight back as a received frame. **gRPC Echo (server stream)** opens a
      server stream (`DummyServerStream`): one request, a burst of echoed frames.
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables:
          - key: echoval
            value:
              type: string
              value: echo-substituted-42
            enabled: true
        id: 1b2c3d4e-5f60-4718-8293-a4b5c6d7e8f9
    items:
      - type: grpc
        name: gRPC Headers (metadata echo)
        documentation: |-
          Calls grpcbin's HeadersUnary, which echoes the received gRPC metadata
          back in the response. A metadata value of `{{echoval}}` proves env-var
          / Handlebars substitution reaches the wire (the echoed response must
          contain the resolved value, not the literal template).
        tags:
          - grpc
          - unary
        url: localhost:9000
        service: grpcbin.GRPCBin
        method: HeadersUnary
        callType: unary
        requestMessage: '{}'
        metadata:
          - key: x-echo
            value:
              type: expression
              value: '{{echoval}}'
            enabled: true
        id: c3d4e5f6-0718-4293-a4b5-c6d7e8f90213
      - type: grpc
        name: gRPC Echo (bidi)
        documentation: Open a bidirectional stream and echo each sent frame back.
        tags:
          - grpc
          - bidirectional-stream
        url: localhost:9000
        service: grpcbin.GRPCBin
        method: DummyBidirectionalStreamStream
        callType: bidirectional-stream
        requestMessage: |-
          {
            "f_string": "hello"
          }
        metadata: []
        id: c1a2b3c4-d5e6-4f70-8819-2a3b4c5d6e7f
      - type: grpc
        name: gRPC Unary
        documentation: A single request → single response unary call (DummyUnary).
        tags:
          - grpc
          - unary
        url: localhost:9000
        service: grpcbin.GRPCBin
        method: DummyUnary
        callType: unary
        requestMessage: |-
          {
            "f_string": "ping"
          }
        metadata: []
        id: a0b1c2d3-e4f5-4061-8273-849506172839
      - type: grpc
        name: gRPC Echo (client stream)
        documentation: |-
          A stream of request messages → one final response (DummyClientStream).
          Note: moul/grpcbin's DummyClientStream returns gRPC status 13 (INTERNAL,
          "Marshal called with nil") server-side regardless of input — a known
          grpcbin quirk — so this exercises the client-stream plumbing + gRPC
          status propagation rather than a clean echo.
        tags:
          - grpc
          - client-stream
        url: localhost:9000
        service: grpcbin.GRPCBin
        method: DummyClientStream
        callType: client-stream
        requestMessage: |-
          {
            "f_string": "chunk"
          }
        metadata: []
        id: b1c2d3e4-f506-4172-8394-a5b6c7d80192
      - type: grpc
        name: gRPC Echo (server stream)
        documentation: Open a server stream — one request, a burst of echoed frames.
        tags:
          - grpc
          - server-stream
        url: localhost:9000
        service: grpcbin.GRPCBin
        method: DummyServerStream
        callType: server-stream
        requestMessage: |-
          {
            "f_string": "stream-me"
          }
        metadata: []
        id: d2b3c4d5-e6f7-4081-9a2b-3c4d5e6f7081
      - type: grpc
        name: gRPC Error (SpecificError)
        documentation: |-
          Calls grpcbin's SpecificError with code=3 (INVALID_ARGUMENT), exercising
          the executeUnary error branch: the response panel must surface the
          non-OK status code and the human-readable label from grpcStatusName().
        tags:
          - grpc
          - unary
          - error
        url: localhost:9000
        service: grpcbin.GRPCBin
        method: SpecificError
        callType: unary
        requestMessage: |-
          {
            "code": 3,
            "reason": "e2e-error-mapping-test"
          }
        metadata: []
        id: e5f6a7b8-c9d0-4e1f-b2c3-d4e5f6a7b8c9
    id: e3c4d5e6-f708-4192-ab3c-4d5e6f708192
    fileFormatVersion: 1
_projectUuid: f4d5e6f7-0819-42a3-bc4d-5e6f70819203
