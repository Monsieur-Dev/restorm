collections:
  - folderType: environment
    name: MQTT Playground
    documentation: |-
      # MQTT Playground

      A self-contained MQTT playground: restorm HOSTS a local MQTT broker AND
      connects to it as a client — no external Mosquitto needed.

      - **MQTT Broker** hosts an aedes broker on `mqtt://localhost:1899`. It
        subscribes internally to `restorm/e2e/chat` (so every published frame
        surfaces in its chat) and its Send button publishes to that topic.
      - **MQTT Chat** connects to the hosted broker, subscribes to
        `restorm/e2e/chat` on connect, and its Send button publishes the
        configured payload to that same topic — which round-trips straight back
        through the subscription, so a single request both sends and receives.
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables:
          - key: brokerUrl
            value:
              type: string
              value: mqtt://localhost:1899
            description: The restorm-hosted MQTT broker
        id: f4d1b2c0-7e3a-4c19-9b6e-2a8d51e0c7a1
    items:
      - type: websocket
        name: MQTT Broker
        documentation: Host a local MQTT broker on `mqtt://localhost:1899`; surface + publish on `restorm/e2e/chat`.
        tags:
          - mqtt
        url: mqtt://localhost:1899
        protocol: mqtt
        server: true
        event: restorm/e2e/chat
        message: |-
          {
            "hello": "from broker"
          }
        headers: []
        id: 7a0e3f91-2c4b-4d76-9a18-5b3e0c7d2f44
      - type: websocket
        name: MQTT Chat
        documentation: Connect to the hosted broker, subscribe + publish on `restorm/e2e/chat`.
        tags:
          - mqtt
        url: '{{brokerUrl}}'
        protocol: mqtt
        event: restorm/e2e/chat
        message: |-
          {
            "hello": "from mqtt"
          }
        headers: []
        id: 9c1f0a52-3b6d-4e88-bb70-1d6f4a2e9c33
    id: c8e2a9d4-5f17-43b0-8c2a-6e9b7d3f1a02
    fileFormatVersion: 1
_projectUuid: a1b2c3d4-e5f6-4708-9a0b-1c2d3e4f5061
