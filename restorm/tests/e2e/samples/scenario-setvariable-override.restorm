    id: 7e5e0cde-1b20-4e03-a285-1eb874dea50d
    name: Swagger Petstore
    apiDocumentation:
      sourceType: swagger
      api:
        title: Swagger Petstore
        description: 'This is a sample server Petstore server.  You can find out more about Swagger at [http://swagger.io](http://swagger.io) or on [irc.freenode.net, #swagger](http://swagger.io/irc/).  For this sample, you can use the api key `special-key` to test the authorization filters.'
        version: 1.0.7
        contact:
          email: apiteam@swagger.io
        license:
          name: Apache 2.0
          url: http://www.apache.org/licenses/LICENSE-2.0.html
        termsOfService: http://swagger.io/terms/
        externalDocs:
          description: Find out more about Swagger
          url: http://swagger.io
      models:
        ApiResponse:
          name: ApiResponse
          properties:
            - name: code
              type: integer
              required: false
              format: int32
            - name: type
              type: string
              required: false
            - name: message
              type: string
              required: false
        Category:
          name: Category
          properties:
            - name: id
              type: integer
              required: false
              format: int64
            - name: name
              type: string
              required: false
          xml:
            name: Category
        Pet:
          name: Pet
          properties:
            - name: id
              type: integer
              required: false
              format: int64
            - name: category
              type: Category
              required: false
              targetModelRef: Category
            - name: name
              type: string
              required: true
              example: doggie
            - name: photoUrls
              type: array<string>
              required: true
              xml:
                wrapped: true
            - name: tags
              type: array<Tag>
              required: false
              targetModelRef: Tag
              isArrayOfRef: true
              xml:
                wrapped: true
            - name: status
              type: string
              required: false
              description: pet status in the store
              enumValues:
                - available
                - pending
                - sold
          xml:
            name: Pet
        Tag:
          name: Tag
          properties:
            - name: id
              type: integer
              required: false
              format: int64
            - name: name
              type: string
              required: false
          xml:
            name: Tag
        Order:
          name: Order
          properties:
            - name: id
              type: integer
              required: false
              format: int64
            - name: petId
              type: integer
              required: false
              format: int64
            - name: quantity
              type: integer
              required: false
              format: int32
            - name: shipDate
              type: string
              required: false
              format: date-time
            - name: status
              type: string
              required: false
              description: Order Status
              enumValues:
                - placed
                - approved
                - delivered
            - name: complete
              type: boolean
              required: false
          xml:
            name: Order
        User:
          name: User
          properties:
            - name: id
              type: integer
              required: false
              format: int64
            - name: username
              type: string
              required: false
            - name: firstName
              type: string
              required: false
            - name: lastName
              type: string
              required: false
            - name: email
              type: string
              required: false
            - name: password
              type: string
              required: false
            - name: phone
              type: string
              required: false
            - name: userStatus
              type: integer
              required: false
              format: int32
              description: User Status
          xml:
            name: User
      groups:
        pet:
          name: pet
          description: Everything about your Pets
          externalDocs:
            description: Find out more
            url: http://swagger.io
        store:
          name: store
          description: Access to Petstore orders
        user:
          name: user
          description: Operations about user
          externalDocs:
            description: Find out more about our store
            url: http://swagger.io
      operations:
        - match:
            urlPattern: /pet/{petId}/uploadImage
            method: POST
          group: pet
          summary: uploads an image
          description: ''
          operationId: uploadFile
          consumes:
            - multipart/form-data
          produces:
            - application/json
          parameters:
            - name: petId
              location: path
              type: integer
              required: true
              format: int64
              description: ID of pet to update
            - name: additionalMetadata
              location: formData
              type: string
              required: false
              description: Additional data to pass to server
            - name: file
              location: formData
              type: file
              required: false
              description: file to upload
          responses:
            '200':
              description: successful operation
              schema: ApiResponse
          security:
            - petstore_auth:
                - write:pets
                - read:pets
          referencedModels:
            - ApiResponse
        - match:
            urlPattern: /pet
            method: POST
          group: pet
          summary: Add a new pet to the store
