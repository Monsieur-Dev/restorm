          produces:
            - application/json
            - application/xml
          parameters:
            - name: username
              location: path
              type: string
              required: true
              description: 'The name that needs to be fetched. Use user1 for testing. '
          responses:
            '200':
              description: successful operation
              schema: User
            '400':
              description: Invalid username supplied
            '404':
              description: User not found
          referencedModels:
            - User
        - match:
            urlPattern: /user/{username}
            method: PUT
          group: user
          summary: Updated user
          description: This can only be done by the logged in user.
          operationId: updateUser
          consumes:
            - application/json
          produces:
            - application/json
            - application/xml
          parameters:
            - name: username
              location: path
              type: string
              required: true
