              location: body
              type: Pet
              required: true
              description: Pet object that needs to be added to the store
          responses:
            '405':
              description: Invalid input
          security:
            - petstore_auth:
                - write:pets
                - read:pets
          referencedModels:
            - Pet
        - match:
            urlPattern: /pet
            method: PUT
          group: pet
          summary: Update an existing pet
