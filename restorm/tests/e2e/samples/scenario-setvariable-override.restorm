fileFormatVersion: 1
collections:
  - id: 7e5e0cde-1b20-4e03-a285-1eb874dea50d
    name: Swagger Petstore
    folderType: environment
    apiDocumentation:
      api:
        contact:
          email: apiteam@swagger.io
        description: 'This is a sample server Petstore server.  You can find out more about Swagger at [http://swagger.io](http://swagger.io) or on [irc.freenode.net, #swagger](http://swagger.io/irc/).  For this sample, you can use the api key `special-key` to test the authorization filters.'
        externalDocs:
          url: http://swagger.io
          description: Find out more about Swagger
        license:
          name: Apache 2.0
          url: http://www.apache.org/licenses/LICENSE-2.0.html
        termsOfService: http://swagger.io/terms/
        title: Swagger Petstore
        version: 1.0.7
      groups:
        pet:
          name: pet
          description: Everything about your Pets
          externalDocs:
            url: http://swagger.io
            description: Find out more
        store:
          name: store
          description: Access to Petstore orders
        user:
          name: user
          description: Operations about user
          externalDocs:
            url: http://swagger.io
            description: Find out more about our store
      models:
        ApiResponse:
          name: ApiResponse
          properties:
            - name: code
              type: integer
              format: int32
              required: false
            - name: type
              type: string
              required: false
            - name: message
              type: string
              required: false
        Category:
          name: Category
          properties:
            - name: id
              type: integer
              format: int64
              required: false
            - name: name
              type: string
              required: false
          xml:
            name: Category
        Order:
          name: Order
          properties:
            - name: id
              type: integer
              format: int64
              required: false
            - name: petId
              type: integer
              format: int64
              required: false
            - name: quantity
              type: integer
              format: int32
              required: false
            - name: shipDate
              type: string
              format: date-time
              required: false
            - name: status
              type: string
              description: Order Status
              enumValues:
                - placed
                - approved
                - delivered
              required: false
            - name: complete
              type: boolean
              required: false
          xml:
            name: Order
        Pet:
          name: Pet
          properties:
            - name: id
              type: integer
              format: int64
              required: false
            - name: category
              type: Category
              required: false
              targetModelRef: Category
            - name: name
              type: string
              example: doggie
              required: true
            - name: photoUrls
              type: array<string>
              required: true
              xml:
                wrapped: true
            - name: tags
              type: array<Tag>
              isArrayOfRef: true
              required: false
              targetModelRef: Tag
              xml:
                wrapped: true
            - name: status
              type: string
              description: pet status in the store
              enumValues:
                - available
                - pending
                - sold
              required: false
          xml:
            name: Pet
        Tag:
          name: Tag
          properties:
            - name: id
              type: integer
              format: int64
              required: false
            - name: name
              type: string
              required: false
          xml:
            name: Tag
        User:
          name: User
          properties:
            - name: id
              type: integer
              format: int64
              required: false
            - name: username
              type: string
              required: false
            - name: firstName
              type: string
              required: false
            - name: lastName
              type: string
              required: false
            - name: email
              type: string
              required: false
            - name: password
              type: string
              required: false
            - name: phone
              type: string
              required: false
            - name: userStatus
              type: integer
              description: User Status
              format: int32
              required: false
          xml:
            name: User
      operations:
        - consumes:
            - multipart/form-data
          description: ''
          group: pet
          match:
            method: POST
            urlPattern: /pet/{petId}/uploadImage
          operationId: uploadFile
          parameters:
            - name: petId
              type: integer
              description: ID of pet to update
              format: int64
              location: path
              required: true
            - name: additionalMetadata
              type: string
              description: Additional data to pass to server
              location: formData
              required: false
            - name: file
              type: file
              description: file to upload
              location: formData
              required: false
          produces:
            - application/json
          referencedModels:
            - ApiResponse
          responses:
            '200':
              description: successful operation
              schema: ApiResponse
          security:
            - petstore_auth:
                - write:pets
                - read:pets
          summary: uploads an image
        - consumes:
            - application/json
            - application/xml
          description: ''
          group: pet
          match:
            method: POST
            urlPattern: /pet
          operationId: addPet
          parameters:
            - name: body
              type: Pet
              description: Pet object that needs to be added to the store
              location: body
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - Pet
          responses:
            '405':
              description: Invalid input
          security:
            - petstore_auth:
                - write:pets
                - read:pets
          summary: Add a new pet to the store
        - consumes:
            - application/json
            - application/xml
          description: ''
          group: pet
          match:
            method: PUT
            urlPattern: /pet
          operationId: updatePet
          parameters:
            - name: body
              type: Pet
              description: Pet object that needs to be added to the store
              location: body
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - Pet
          responses:
            '400':
              description: Invalid ID supplied
            '404':
              description: Pet not found
            '405':
              description: Validation exception
          security:
            - petstore_auth:
                - write:pets
                - read:pets
          summary: Update an existing pet
        - description: Multiple status values can be provided with comma separated strings
          group: pet
          match:
            method: GET
            urlPattern: /pet/findByStatus
          operationId: findPetsByStatus
          parameters:
            - name: status
              type: array
              collectionFormat: multi
              description: Status values that need to be considered for filter
              location: query
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - Pet
          responses:
            '200':
              description: successful operation
              schema: array<Pet>
            '400':
              description: Invalid status value
          security:
            - petstore_auth:
                - write:pets
                - read:pets
          summary: Finds Pets by status
        - deprecated: true
          description: Multiple tags can be provided with comma separated strings. Use tag1, tag2, tag3 for testing.
          group: pet
          match:
            method: GET
            urlPattern: /pet/findByTags
          operationId: findPetsByTags
          parameters:
            - name: tags
              type: array
              collectionFormat: multi
              description: Tags to filter by
              location: query
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - Pet
          responses:
            '200':
              description: successful operation
              schema: array<Pet>
            '400':
              description: Invalid tag value
          security:
            - petstore_auth:
                - write:pets
                - read:pets
          summary: Finds Pets by tags
        - description: Returns a single pet
          group: pet
          match:
            method: GET
            urlPattern: /pet/{petId}
          operationId: getPetById
          parameters:
            - name: petId
              type: integer
              description: ID of pet to return
              format: int64
              location: path
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - Pet
          responses:
            '200':
              description: successful operation
              schema: Pet
            '400':
              description: Invalid ID supplied
            '404':
              description: Pet not found
          security:
            - api_key: []
          summary: Find pet by ID
        - consumes:
            - application/x-www-form-urlencoded
          description: ''
          group: pet
          match:
            method: POST
            urlPattern: /pet/{petId}
          operationId: updatePetWithForm
          parameters:
            - name: petId
              type: integer
              description: ID of pet that needs to be updated
              format: int64
              location: path
              required: true
            - name: name
              type: string
              description: Updated name of the pet
              location: formData
              required: false
            - name: status
              type: string
              description: Updated status of the pet
              location: formData
              required: false
          produces:
            - application/json
            - application/xml
          responses:
            '405':
              description: Invalid input
          security:
            - petstore_auth:
                - write:pets
                - read:pets
          summary: Updates a pet in the store with form data
        - description: ''
          group: pet
          match:
            method: DELETE
            urlPattern: /pet/{petId}
          operationId: deletePet
          parameters:
            - name: api_key
              type: string
              location: header
              required: false
            - name: petId
              type: integer
              description: Pet id to delete
              format: int64
              location: path
              required: true
          produces:
            - application/json
            - application/xml
          responses:
            '400':
              description: Invalid ID supplied
            '404':
              description: Pet not found
          security:
            - petstore_auth:
                - write:pets
                - read:pets
          summary: Deletes a pet
        - consumes:
            - application/json
          description: ''
          group: store
          match:
            method: POST
            urlPattern: /store/order
          operationId: placeOrder
          parameters:
            - name: body
              type: Order
              description: order placed for purchasing the pet
              location: body
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - Order
          responses:
            '200':
              description: successful operation
              schema: Order
            '400':
              description: Invalid Order
          summary: Place an order for a pet
        - description: For valid response try integer IDs with value >= 1 and <= 10. Other values will generated exceptions
          group: store
          match:
            method: GET
            urlPattern: /store/order/{orderId}
          operationId: getOrderById
          parameters:
            - name: orderId
              type: integer
              constraints:
                maximum: 10
                minimum: 1
              description: ID of pet that needs to be fetched
              format: int64
              location: path
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - Order
          responses:
            '200':
              description: successful operation
              schema: Order
            '400':
              description: Invalid ID supplied
            '404':
              description: Order not found
          summary: Find purchase order by ID
        - description: For valid response try integer IDs with positive integer value. Negative or non-integer values will generate API errors
          group: store
          match:
            method: DELETE
            urlPattern: /store/order/{orderId}
          operationId: deleteOrder
          parameters:
            - name: orderId
              type: integer
              constraints:
                minimum: 1
              description: ID of the order that needs to be deleted
              format: int64
              location: path
              required: true
          produces:
            - application/json
            - application/xml
          responses:
            '400':
              description: Invalid ID supplied
            '404':
              description: Order not found
          summary: Delete purchase order by ID
        - description: Returns a map of status codes to quantities
          group: store
          match:
            method: GET
            urlPattern: /store/inventory
          operationId: getInventory
          produces:
            - application/json
          responses:
            '200':
              description: successful operation
              schema: object
          security:
            - api_key: []
          summary: Returns pet inventories by status
        - consumes:
            - application/json
          description: ''
          group: user
          match:
            method: POST
            urlPattern: /user/createWithArray
          operationId: createUsersWithArrayInput
          parameters:
            - name: body
              type: array<User>
              description: List of user object
              location: body
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - User
          responses:
            default:
              description: successful operation
          summary: Creates list of users with given input array
        - consumes:
            - application/json
          description: ''
          group: user
          match:
            method: POST
            urlPattern: /user/createWithList
          operationId: createUsersWithListInput
          parameters:
            - name: body
              type: array<User>
              description: List of user object
              location: body
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - User
          responses:
            default:
              description: successful operation
          summary: Creates list of users with given input array
        - description: ''
          group: user
          match:
            method: GET
            urlPattern: /user/{username}
          operationId: getUserByName
          parameters:
            - name: username
              type: string
              description: 'The name that needs to be fetched. Use user1 for testing. '
              location: path
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - User
          responses:
            '200':
              description: successful operation
              schema: User
            '400':
              description: Invalid username supplied
            '404':
              description: User not found
          summary: Get user by user name
        - consumes:
            - application/json
          description: This can only be done by the logged in user.
          group: user
          match:
            method: PUT
            urlPattern: /user/{username}
          operationId: updateUser
          parameters:
            - name: username
              type: string
              description: name that need to be updated
              location: path
              required: true
            - name: body
              type: User
              description: Updated user object
              location: body
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - User
          responses:
            '400':
              description: Invalid user supplied
            '404':
              description: User not found
          summary: Updated user
        - description: This can only be done by the logged in user.
          group: user
          match:
            method: DELETE
            urlPattern: /user/{username}
          operationId: deleteUser
          parameters:
            - name: username
              type: string
              description: The name that needs to be deleted
              location: path
              required: true
          produces:
            - application/json
            - application/xml
          responses:
            '400':
              description: Invalid username supplied
            '404':
              description: User not found
          summary: Delete user
        - description: ''
          group: user
          match:
            method: GET
            urlPattern: /user/login
          operationId: loginUser
          parameters:
            - name: username
              type: string
              description: The user name for login
              location: query
              required: true
            - name: password
              type: string
              description: The password for login in clear text
              location: query
              required: true
          produces:
            - application/json
            - application/xml
          responses:
            '200':
              description: successful operation
              headers:
                X-Expires-After:
                  type: string
                  description: date in UTC when token expires
                  format: date-time
                X-Rate-Limit:
                  type: integer
                  description: calls per hour allowed by the user
                  format: int32
              schema: string
            '400':
              description: Invalid username/password supplied
          summary: Logs user into the system
        - description: ''
          group: user
          match:
            method: GET
            urlPattern: /user/logout
          operationId: logoutUser
          produces:
            - application/json
            - application/xml
          responses:
            default:
              description: successful operation
          summary: Logs out current logged in user session
        - consumes:
            - application/json
          description: This can only be done by the logged in user.
          group: user
          match:
            method: POST
            urlPattern: /user
          operationId: createUser
          parameters:
            - name: body
              type: User
              description: Created user object
              location: body
              required: true
          produces:
            - application/json
            - application/xml
          referencedModels:
            - User
          responses:
            default:
              description: successful operation
          summary: Create user
      securitySchemes:
        api_key:
          name: api_key
          type: apiKey
          in: header
        petstore_auth:
          type: oauth2
          flows:
            - type: implicit
              authorizationUrl: https://petstore.swagger.io/oauth/authorize
              scopes:
                read:pets: read your pets
                write:pets: modify pets in your account
      server:
        basePath: /api
        host: localhost:8080
        schemes:
          - https
          - http
      sourceType: swagger
      sourceUrl: http://localhost:8080/api/swagger.json
    apiUpdate:
      lastImportedAt: 1782686173349
      payloadChecksum: sha256:7ad2c35ade2afd0b718238f965b081710e9b7d1230f65529b91018890f401b8d
      sourceUrl: http://localhost:8080/api/swagger.json
    configuration: {}
    environments:
      - id: 69900928-0012-4000-8000-699009286990
        name: localhost
        subEnvironments:
          - id: 3d7857e7-0018-4000-8000-3d7857e73d78
            name: https
            variables:
              - key: scheme
                description: ''
                enabled: true
                value:
                  type: string
                  value: https
        variables:
          - key: scheme
            description: ''
            enabled: true
            value:
              type: string
              value: http
          - key: host
            description: ''
            enabled: true
            value:
              type: string
              value: localhost
          - key: port
            description: ''
            enabled: true
            value:
              type: numeric
              format: decimal
              value: 8080
          - key: baseRoute
            description: ''
            enabled: true
            value:
              type: string
              value: /api
          - key: baseUrl
            description: ''
            enabled: true
            value:
              type: expression
              value: '{{scheme}}://{{host}}:{{port}}{{baseRoute}}'
          - key: api_key
            description: ''
            enabled: true
            value:
              type: secret
              params: {}
              source: envFileSecret
          - key: petstore_auth_token
            description: ''
            enabled: true
            value:
              type: secret
              params: {}
              source: envFileSecret
          - key: petId
            description: ''
            enabled: true
            value:
              type: numeric
              format: decimal
              value: 3
    importSource: swagger
    items:
      - id: 75acded1-768e-46a5-b86e-efbf22d7515a
        name: pet
        configuration: {}
        items:
          - id: 6714c0d5-c480-4a9b-add4-837f2fd60021
            name: uploads an image
            type: http
            method: POST
            url: '{{baseUrl}}/pet/{{petId}}/uploadImage'
            body:
              type: form-data
              fields:
                - key: additionalMetadata
                  description: Additional data to pass to server
                  enabled: true
                  value:
                    type: string
                    value: ''
                - key: file
                  description: file to upload
                  enabled: true
                  value:
                    type: string
                    value: ''
            deprecated: false
            documentation: ''
            headers:
              - key: Authorization
                enabled: true
                value:
                  type: expression
                  value: Bearer {{petstore_auth_token}}
            params: []
            pathParams:
              - key: petId
                description: ID of pet to update
                enabled: true
                value:
                  type: numeric
                  format: decimal
                  value: 0
            tags:
              - pet
          - id: 7aa71822-325a-424c-a86a-239fecfb3300
            name: Add a new pet to the store
            type: http
            method: POST
            url: '{{baseUrl}}/pet'
            body:
              type: text
              content: |-
                {
                  "id": 0,
                  "category": {
                    "id": 0,
                    "name": ""
                  },
                  "name": "",
                  "photoUrls": [
                    ""
                  ],
                  "tags": [
                    {
                      "id": 0,
                      "name": ""
                    }
                  ],
                  "status": "available"
                }
            deprecated: false
            documentation: ''
            headers:
              - key: Authorization
                enabled: true
                value:
                  type: expression
                  value: Bearer {{petstore_auth_token}}
            params: []
            pathParams: []
            tags:
              - pet
          - id: 936a3026-9c14-45fa-bf07-875126049cb4
            name: Update an existing pet
            type: http
            method: PUT
            url: '{{baseUrl}}/pet'
            body:
              type: text
              content: |-
                {
                  "id": 0,
                  "category": {
                    "id": 0,
                    "name": ""
                  },
                  "name": "",
                  "photoUrls": [
                    ""
                  ],
                  "tags": [
                    {
                      "id": 0,
                      "name": ""
                    }
                  ],
                  "status": "available"
                }
            deprecated: false
            documentation: ''
            headers:
              - key: Authorization
                enabled: true
                value:
                  type: expression
                  value: Bearer {{petstore_auth_token}}
            params: []
            pathParams: []
            tags:
              - pet
          - id: ea56da69-c8a5-4705-949c-4ae23cfb3695
            name: Finds Pets by status
            type: http
            method: GET
            url: '{{baseUrl}}/pet/findByStatus'
            deprecated: false
            documentation: ''
            headers:
              - key: Authorization
                enabled: true
                value:
                  type: expression
                  value: Bearer {{petstore_auth_token}}
            params:
              - key: status
                description: Status values that need to be considered for filter
                enabled: true
                value:
                  type: enumList
                  enumDefinitionId: 2b3bddb4-000f-4000-8000-2b3bddb42b3b
                  value:
                    - available
            pathParams: []
            tags:
              - pet
          - id: ebc52e40-0257-413a-9cae-4a9a48ff180a
            name: Finds Pets by tags
            type: http
            method: GET
            url: '{{baseUrl}}/pet/findByTags'
            deprecated: true
            documentation: ''
            headers:
              - key: Authorization
                enabled: true
                value:
                  type: expression
                  value: Bearer {{petstore_auth_token}}
            params:
              - key: tags
                description: Tags to filter by
                enabled: false
                value:
                  type: string
                  value: ''
            pathParams: []
            tags:
              - pet
          - id: 46712c9e-10ca-4e71-b0df-45cb647a035f
            name: Find pet by ID
            type: http
            method: GET
            url: '{{baseUrl}}/pet/{{petId}}'
            deprecated: false
            documentation: ''
            headers:
              - key: api_key
                enabled: true
                value:
                  type: expression
                  value: '{{api_key}}'
            params: []
            pathParams:
              - key: petId
                description: ID of pet to return
                enabled: true
                value:
                  type: expression
                  value: '{{petId}}'
            quickConfigs:
              - id: qc_mqydc5lz_duo5kh
                name: pet1
                fields:
                  method: GET
                  url: '{{baseUrl}}/pet/{{petId}}'
                  headers:
                    - key: api_key
                      value:
                        type: expression
                        value: '{{api_key}}'
                  params: []
                  pathParams:
                    - key: petId
                      description: ID of pet to return
                      enabled: true
                      value:
                        type: numeric
                        format: decimal
                        value: 1
                requestId: 46712c9e-10ca-4e71-b0df-45cb647a035f
                storageTarget: project
              - id: qc_mqydcc2d_mdhocy
                name: pet2
                fields:
                  method: GET
                  url: '{{baseUrl}}/pet/{{petId}}'
                  headers:
                    - key: api_key
                      value:
                        type: expression
                        value: '{{api_key}}'
                  params: []
                  pathParams:
                    - key: petId
                      description: ID of pet to return
                      enabled: true
                      value:
                        type: numeric
                        format: decimal
                        value: 2
                requestId: 46712c9e-10ca-4e71-b0df-45cb647a035f
                storageTarget: project
            tags:
              - pet
          - id: 425facbb-17a3-44cb-8f8a-7dbd5c4b7324
            name: Updates a pet in the store with form data
            type: http
            method: POST
            url: '{{baseUrl}}/pet/{{petId}}'
            body:
              type: x-www-form-urlencoded
              fields:
                - key: name
                  description: Updated name of the pet
                  enabled: true
                  value:
                    type: string
                    value: ''
                - key: status
                  description: Updated status of the pet
                  enabled: true
                  value:
                    type: string
                    value: ''
            deprecated: false
            documentation: ''
            headers:
              - key: Authorization
                enabled: true
                value:
                  type: expression
                  value: Bearer {{petstore_auth_token}}
            params: []
            pathParams:
              - key: petId
                description: ID of pet that needs to be updated
                enabled: true
                value:
                  type: numeric
                  format: decimal
                  value: 0
