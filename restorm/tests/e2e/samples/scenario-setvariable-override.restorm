            - application/xml
          parameters:
            - name: body
              location: body
              type: User
              required: true
              description: Created user object
          responses:
            default:
              description: successful operation
          referencedModels:
            - User
      sourceUrl: http://localhost:8080/api/swagger.json
      server:
        host: localhost:8080
        basePath: /api
        schemes:
          - https
          - http
      securitySchemes:
        api_key:
          type: apiKey
          name: api_key
          in: header
        petstore_auth:
          type: oauth2
          flows:
            - type: implicit
              scopes:
                read:pets: read your pets
                write:pets: modify pets in your account
              authorizationUrl: https://petstore.swagger.io/oauth/authorize
