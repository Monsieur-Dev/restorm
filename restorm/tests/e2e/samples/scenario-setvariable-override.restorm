            - application/xml
          produces:
            - application/json
            - application/xml
          parameters:
            - name: body
              location: body
              type: Pet
              required: true
              description: Pet object that needs to be added to the store
          responses:
            '400':
              description: Invalid ID supplied
            '404':
              description: Pet not found
            '405':
              description: Validation exception
          security:
            - petstore_auth:
                - write:pets
                - read:pets
          referencedModels:
            - Pet
        - match:
