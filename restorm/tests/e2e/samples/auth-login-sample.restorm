fileFormatVersion: 1
collections:
  - id: a0000000-0000-0000-0000-00000000auth
    name: Auth Service
    folderType: environment
    configuration: {}
    environments:
      - id: b733acbe-f3de-5b8c-b458-40de5407ec74
        name: localhost
        variables:
          - key: baseUrl
            enabled: true
            value:
              type: string
              value: http://localhost:5110
          - key: clientId
            enabled: true
            value:
              type: string
              value: VALID_CLIENT_ID
    items:
      - id: a1000000-0000-0000-0000-00000000auth
        name: Login
        type: auth
        method: POST
        url: '{{baseUrl}}/login'
        authErrorCodes:
          - 401
          - 403
        body:
          type: text
          contentType: application/json
          text: |
            {
              "client_id": "{{clientId}}"
            }
        deprecated: false
        documentation: ''
        headers:
          - key: Content-Type
            enabled: true
            value:
              type: string
              value: application/json
        params: []
        pathParams: []
        producedHeaders:
          - key: Authorization
            enabled: true
            value:
              type: expression
              value: '{{auth_type}} {{auth_token}}'
        tags:
          - auth
      - id: f1000000-0000-0000-0000-00000000auth
        name: Pet API
        configuration: {}
        documentation: ''
        items:
          - id: d1000000-0000-0000-0000-00000000auth
            name: Health
            type: http
            method: GET
            url: '{{baseUrl}}/health'
            deprecated: false
            documentation: Liveness probe — no auth required.
            headers: []
            params: []
            pathParams: []
            tags: []
          - id: d2000000-0000-0000-0000-00000000auth
            name: Get Pet by Id
            type: http
            method: GET
            url: '{{baseUrl}}/pet/1'
            authenticationRequestId: a1000000-0000-0000-0000-00000000auth
            deprecated: false
            documentation: Requires the Login auth route.
            headers:
              - key: Accept
                enabled: true
                value:
                  type: string
                  value: application/json
            params: []
            pathParams: []
            tags: []
        tags: []
    tagColors: {}
    tags:
      - auth
_projectUuid: 365ee6c3-ea01-4c75-802e-30b8a50821c0
