fileFormatVersion: 1
collections:
  - folderType: environment
    name: Kafka Playground
    documentation: |-
      # Kafka Playground

      A self-contained Kafka playground against the `restorm-kafka` mock
      broker (`tests/docker/docker-compose.yml`), seeded with the `restorm-test`
      topic (3 messages, 1 partition — see `kafka-seed.sh`).

      - **Kafka Produce** sends one record to `restorm-test` (mode: produce).
      - **Kafka Consume** subscribes to `restorm-test` from the earliest offset
        under a dedicated consumer group, so it always replays the 3 seeded
        messages deterministically on connect.
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables:
          - key: brokerUrl
            value:
              type: string
              value: localhost:9092
            description: The restorm-kafka mock broker (docker-compose)
        id: e3a1f6b0-4c2d-4a9e-8b3f-7d5c1e9a6f02
    items:
      - type: kafka
        name: Kafka Produce
        documentation: One-shot produce to `restorm-test` on the mock broker.
        tags:
          - kafka
        url: '{{brokerUrl}}'
        clientId: restorm
        mode: produce
        topic: restorm-test
        value: |-
          {
            "hello": "from restorm"
          }
        headers: []
        fromOffset: latest
        saslMechanism: none
        id: 1b7e4d2a-6f38-4c15-9a02-8e6b3d1f5c47
      - type: kafka
        name: Kafka Consume
        documentation: Long-lived consumer on `restorm-test`, earliest offset, its own group — always replays the 3 seeded messages.
        tags:
          - kafka
        url: '{{brokerUrl}}'
        clientId: restorm
        mode: consume
        topic: restorm-test
        value: ''
        headers: []
        groupId: restorm-e2e-consumer
        fromOffset: earliest
        saslMechanism: none
        id: 2c8f5e3b-704a-4d26-8b13-9f7c4e2a6d58
      - type: kafka
        name: Kafka Consume Latest
        documentation: Long-lived consumer on `restorm-test`, latest offset, its own group — reads only records produced after it joins (mirrors a manual "start consuming, then produce" flow).
        tags:
          - kafka
        url: '{{brokerUrl}}'
        clientId: restorm
        mode: consume
        topic: restorm-test
        value: ''
        headers: []
        groupId: restorm-e2e-consumer-live
        fromOffset: latest
        saslMechanism: none
        id: 3d9a6f4c-815b-4e37-9c24-0a8d5f3b7e69
    id: d4b2a9e6-5f18-43c0-8d2b-6e9a7c3f1b09
_projectUuid: b2c3d4e5-f607-4819-9a0c-2d3e4f506172
