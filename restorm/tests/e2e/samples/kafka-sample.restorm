fileFormatVersion: 1
collections:
  - id: d4b2a9e6-5f18-43c0-8d2b-6e9a7c3f1b09
    name: Kafka Playground
    folderType: environment
    configuration: {}
    environments:
      - id: e3a1f6b0-4c2d-4a9e-8b3f-7d5c1e9a6f02
        name: Default
        variables:
          - key: brokerUrl
            description: The restorm-kafka mock broker (docker-compose)
            enabled: true
            value:
              type: string
              value: localhost:9092
    items:
      - id: 1b7e4d2a-6f38-4c15-9a02-8e6b3d1f5c47
        name: Kafka Produce
        type: kafka
        url: '{{brokerUrl}}'
        clientId: restorm
        documentation: One-shot produce to `restorm-test` on the mock broker.
        fromOffset: latest
        headers: []
        mode: produce
        saslMechanism: none
        tags:
          - kafka
        topic: restorm-test
        value: |-
          {
            "hello": "from restorm"
          }
      - id: 2c8f5e3b-704a-4d26-8b13-9f7c4e2a6d58
        name: Kafka Consume
        type: kafka
        url: '{{brokerUrl}}'
        clientId: restorm
        documentation: Long-lived consumer on `restorm-test`, earliest offset, its own group — always replays the 3 seeded messages.
        fromOffset: earliest
        groupId: restorm-e2e-consumer
        headers: []
        mode: consume
        saslMechanism: none
        tags:
          - kafka
        topic: restorm-test
        value: ''
      - id: 3d9a6f4c-815b-4e37-9c24-0a8d5f3b7e69
        name: Kafka Consume Latest
        type: kafka
        url: '{{brokerUrl}}'
        clientId: restorm
        documentation: Long-lived consumer on `restorm-test`, latest offset, its own group — reads only records produced after it joins (mirrors a manual "start consuming, then produce" flow).
        fromOffset: latest
        groupId: restorm-e2e-consumer-live
        headers: []
        mode: consume
        saslMechanism: none
        tags:
          - kafka
        topic: restorm-test
        value: ''
    tagColors: {}
    tags: []
_projectUuid: b2c3d4e5-f607-4819-9a0c-2d3e4f506172
