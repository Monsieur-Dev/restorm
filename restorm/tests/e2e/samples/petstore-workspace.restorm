        - id: ID!
        - username: String!
        - firstName: String
        - lastName: String
        - email: String!
        - phone: String
        - userStatus: Int

      ### Inventory
        - available: Int!
        - pending: Int!
        - sold: Int!

      ### LoginResponse
        - token: String!
        - expiresAt: String!
        - user: User!

      ### ApiResponse
        - code: Int!
        - type: String!
        - message: String!
