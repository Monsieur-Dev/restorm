  - id: 80137947-223f-48b7-bd49-f8861f0b5804
    name: gRPC Petstore
    folderType: environment
    configuration: {}
    documentation: |-
      # gRPC Petstore

      gRPC API

      ## Messages

      ### Category
        - id: int64
        - name: string

      ### Tag
        - id: int64
        - name: string

      ### Pet
        - id: int64
        - name: string
        - category: Category
        - photo_urls: repeated string
        - tags: repeated Tag
        - status: PetStatus

      ### Order
        - id: int64
        - pet_id: int64
        - quantity: int32
        - ship_date: string
        - status: OrderStatus
        - complete: bool

      ### User
        - id: int64
        - username: string
        - first_name: string
        - last_name: string
        - email: string
        - password: string
        - phone: string
        - user_status: int32

      ### GetPetRequest
        - id: int64

      ### ListPetsRequest
        - status: repeated PetStatus
        - tags: repeated string
        - limit: int32
        - offset: int32

      ### ListPetsResponse
        - pets: repeated Pet
        - total: int32

      ### CreatePetRequest
        - name: string
        - category: Category
        - photo_urls: repeated string
        - tags: repeated Tag
        - status: PetStatus

      ### UpdatePetRequest
        - id: int64
        - name: string
        - category: Category
        - photo_urls: repeated string
        - tags: repeated Tag
        - status: PetStatus

      ### DeletePetRequest
        - id: int64

      ### DeletePetResponse
        - success: bool

      ### StreamPetUpdatesRequest
        - status_filter: repeated PetStatus

      ### PetUpdate
        - event_type: string
        - pet: Pet
        - timestamp: string

      ### GetInventoryResponse


      ### PlaceOrderRequest
        - pet_id: int64
        - quantity: int32
        - ship_date: string

      ### GetOrderRequest
        - id: int64

      ### DeleteOrderRequest
        - id: int64

      ### DeleteOrderResponse
        - success: bool

      ### CreateUserRequest
        - username: string
        - first_name: string
        - last_name: string
        - email: string
        - password: string
        - phone: string

      ### GetUserRequest
        - username: string

      ### UpdateUserRequest
        - username: string
        - first_name: string
        - last_name: string
        - email: string
        - password: string
        - phone: string

      ### DeleteUserRequest
        - username: string

      ### DeleteUserResponse
        - success: bool

      ### LoginRequest
        - username: string
        - password: string

      ### LoginResponse
        - token: string
        - expires_at: string

      ### LogoutRequest
        - token: string

      ### LogoutResponse
        - success: bool
    environments:
      - id: f2229a6f-e625-4861-bb2e-7a121156b4ad
        name: Default
        variables:
          - key: baseUrl
            value:
              type: string
              value: localhost:9000
    items:
      - id: 824d0186-d95d-49c0-a48b-59ef2a9fd904
