            type: http
            method: POST
            url: '{{baseUrl}}/api/pet'
            body:
              type: text
              content: |-
                {
                  "id": 0,
                  "category": {
                    "id": 0,
                    "name": ""
                  },
                  "name": "",
                  "photoUrls": [
                    ""
                  ],
                  "tags": [
                    {
                      "id": 0,
                      "name": ""
                    }
                  ],
                  "status": "available"
                }
            documentation: |-
              # Add a new pet to the store

              **Operation ID:** `addPet`

