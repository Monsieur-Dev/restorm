fileFormatVersion: 1
collections:
  - id: 68a560b2-74a1-4aa8-aac1-c2c99b794c4b
    name: Swagger Petstore
    folderType: environment
    configuration: {}
    documentation: |-
      # Swagger Petstore

      This is a sample server Petstore server.  You can find out more about Swagger at [http://swagger.io](http://swagger.io) or on [irc.freenode.net, #swagger](http://swagger.io/irc/).  For this sample, you can use the api key &#x60;special-key&#x60; to test the authorization filters.

      **Version:** 1.0.7

      **Terms of Service:** [http://swagger.io/terms/](http://swagger.io/terms/)

      ## Contact

      - **Email:** [apiteam@swagger.io](mailto:apiteam@swagger.io)

      ## License

      [Apache 2.0](http://www.apache.org/licenses/LICENSE-2.0.html)

      ## External Documentation

      [Find out more about Swagger](http://swagger.io)

      **Host:** `localhost:8080`

      **Base Path:** `/api`

      **Schemes:** `https`, `http`

      ## Models

      ```mermaid
      classDiagram
        class Category {
          - id? : integer
          - name? : string
        }
        class Pet {
          - id? : integer
          - category? : Category
          + name : string
          + photoUrls : array<string>
          - tags? : array<Tag>
          - status? : string
        }
        class Tag {
          - id? : integer
          - name? : string
        }
        class ApiResponse {
          - code? : integer
          - type? : string
          - message? : string
        }
        class Order {
          - id? : integer
          - petId? : integer
          - quantity? : integer
          - shipDate? : string
          - status? : string
          - complete? : boolean
        }
        class User {
          - id? : integer
          - username? : string
          - firstName? : string
          - lastName? : string
          - email? : string
          - password? : string
          - phone? : string
          - userStatus? : integer
        }
        Pet --> Category
        Pet --> Tag
      ```
    environments:
      - id: 518f1827-ceca-49c5-9c1b-d5f63f377a17
        name: Default
        subEnvironments:
          - id: 10f76c97-e8cf-4964-a815-06e3da00c040
            name: Production
            variables:
              - key: scheme
                description: ''
                value:
                  type: string
                  value: https
              - key: domain
                description: ''
                value:
                  type: string
                  value: petstore.com
              - key: baseUrl
                description: ''
                value:
                  type: string
                  value: '{{scheme}}://{{domain}}:{{port}}'
        variables:
          - key: port
            description: ''
            enabled: true
            value:
              type: string
              value: '8080'
          - key: scheme
            description: ''
            enabled: true
            value:
              type: string
              value: http
          - key: domain
            description: ''
            enabled: true
            value:
              type: string
              value: localhost
          - key: baseUrl
            description: ''
            enabled: true
            value:
              type: string
              value: '{{scheme}}://{{domain}}:{{port}}'
    items:
      - id: 3420b328-98e1-4a16-a880-afcc4d504b8f
        name: pet
        configuration: {}
        documentation: "# pet\r\n\r\nEverything about your Pets\r\n\r\n## External Documentation\r\n\r\n[Find out more](http://swagger.io)"
        items:
          - id: a2b361ad-8d56-408c-ad10-2613c1723c8b
            name: Find pet by ID
            type: http
            method: GET
            url: '{{baseUrl}}/api/pet/{{petId}}'
            body:
              type: text
              content: ''
            documentation: |-
              # Find pet by ID

              Returns a single pet

              **Operation ID:** `getPetById`

              ## Produces

              - `application/json`
              - `application/xml`

              ## Parameters

              | Name | Location | Type | Required | Description |
              |------|----------|------|----------|-------------|
              | `petId` | path | integer (int64) | Yes | ID of pet to return |

              ## Types

              ### Pet

              **Reference:** `#/definitions/Pet`

              ```mermaid
              classDiagram
                class Pet {
                  - id? : integer
                  - category? : Category
                  + name : string
                  + photoUrls : array<string>
                  - tags? : array<Tag>
                  - status? : string
                }
              ```


              | Property | Type | Required | Description |
              |----------|------|----------|-------------|
              | `id` | integer | No |  |
              | `category` | Category | No |  |
              | `name` | string | Yes |  |
              | `photoUrls` | array&lt;string&gt; | Yes |  |
              | `tags` | array&lt;Tag&gt; | No |  |
              | `status` | string | No | pet status in the store |


              ## Responses

              ### 200
              successful operation

              **Schema:** `#/definitions/Pet`


              ### 400
              Invalid ID supplied



              ### 404
              Pet not found



              ## Security

              - **api_key**
            headers: []
            notes: ''
            params: []
            pathParams:
              - key: petId
                description: ID of pet to return
                enabled: true
                value:
                  type: string
                  value: '1'
            tags:
              - pet
          - id: 5c1ee5a3-bd47-4fac-9c46-700b7a6a2feb
            name: Updates a pet in the store with form data
            type: http
            method: POST
            url: '{{baseUrl}}/api/pet/{{petId}}'
            body:
              type: x-www-form-urlencoded
              fields:
                - key: name
                  description: Updated name of the pet
                  enabled: true
                  value:
                    type: string
                    value: ''
                - key: status
                  description: Updated status of the pet
                  enabled: true
                  value:
                    type: string
                    value: ''
            documentation: |-
              # Updates a pet in the store with form data

              **Operation ID:** `updatePetWithForm`

              ## Consumes

              - `application/x-www-form-urlencoded`

              ## Produces

              - `application/json`
              - `application/xml`

              ## Parameters

              | Name | Location | Type | Required | Description |
              |------|----------|------|----------|-------------|
              | `petId` | path | integer (int64) | Yes | ID of pet that needs to be updated |
              | `name` | formData | string | No | Updated name of the pet |
              | `status` | formData | string | No | Updated status of the pet |

              ## Responses

              ### 405
              Invalid input



              ## Security

              - **petstore_auth**: `write:pets`, `read:pets`
            headers: []
            params: []
            pathParams:
              - key: petId
                description: ID of pet that needs to be updated
                enabled: true
                value:
                  type: string
                  value: ''
            tags:
              - pet
          - id: e2147556-b61b-4fd2-9fc2-bcd56697e1d5
            name: Deletes a pet
            type: http
            method: DELETE
            url: '{{baseUrl}}/api/pet/{{petId}}'
            body:
              type: text
              content: ''
            documentation: |-
              # Deletes a pet

              **Operation ID:** `deletePet`

              ## Produces

              - `application/json`
              - `application/xml`

              ## Parameters

              | Name | Location | Type | Required | Description |
              |------|----------|------|----------|-------------|
              | `api_key` | header | string | No |  |
              | `petId` | path | integer (int64) | Yes | Pet id to delete |

              ## Responses

              ### 400
              Invalid ID supplied



              ### 404
              Pet not found



              ## Security

              - **petstore_auth**: `write:pets`, `read:pets`
            headers:
              - key: api_key
                description: ''
                enabled: true
                value:
                  type: string
                  value: ''
            params: []
            pathParams:
              - key: petId
                description: Pet id to delete
                enabled: true
                value:
                  type: string
                  value: ''
            tags:
              - pet
          - id: 8fde9cd9-493e-4609-86a3-0e7258d3457a
            name: uploads an image
            type: http
            method: POST
            url: '{{baseUrl}}/api/pet/{{petId}}/uploadImage'
            body:
              type: form-data
              fields:
                - key: additionalMetadata
                  description: Additional data to pass to server
                  enabled: true
                  value:
                    type: string
                    value: ''
                - key: file
                  description: file to upload
                  enabled: true
                  value:
                    type: string
                    value: ''
            documentation: |-
              # uploads an image

              **Operation ID:** `uploadFile`

              ## Consumes

              - `multipart/form-data`

              ## Produces

              - `application/json`

              ## Parameters

              | Name | Location | Type | Required | Description |
              |------|----------|------|----------|-------------|
              | `petId` | path | integer (int64) | Yes | ID of pet to update |
              | `additionalMetadata` | formData | string | No | Additional data to pass to server |
              | `file` | formData | file | No | file to upload |

              ## Types

              ### ApiResponse

              **Reference:** `#/definitions/ApiResponse`

              ```mermaid
              classDiagram
                class ApiResponse {
                  - code? : integer
                  - type? : string
                  - message? : string
                }
              ```


              | Property | Type | Required | Description |
              |----------|------|----------|-------------|
              | `code` | integer | No |  |
              | `type` | string | No |  |
              | `message` | string | No |  |


              ## Responses

              ### 200
              successful operation

              **Schema:** `#/definitions/ApiResponse`


              ## Security

              - **petstore_auth**: `write:pets`, `read:pets`
            headers: []
            params: []
            pathParams:
              - key: petId
                description: ID of pet to update
                value:
                  type: string
                  value: ''
            tags:
              - pet
          - id: 13cc7beb-524e-41ec-aa8d-ed7f31b64061
