          - pet
      - id: ad7fe16f-6cf2-4c92-ad86-3708666a7552
        name: store
        configuration: {}
        documentation: "# store\r\n\r\nAccess to Petstore orders"
        items:
          - id: 3b3b0588-6f71-4774-8ec1-583184a7dcf0
            name: Returns pet inventories by status
