      - id: e90917e9-cba8-47fc-acc5-5f58f50ef4c0
        name: user
        configuration: {}
        documentation: "# user\r\n\r\nOperations about user\r\n\r\n## External Documentation\r\n\r\n[Find out more about our store](http://swagger.io)"
