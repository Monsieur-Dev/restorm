    items:
      - documentation: ''
        tags:
          - auth
        id: a1000000-0000-0000-0000-00000000auth
        name: Login
        method: POST
        url: '{{baseUrl}}/login'
        headers:
          - key: Content-Type
            enabled: true
            value:
              type: string
              value: application/json
        params: []
        pathParams: []
        body:
          type: text
          contentType: application/json
          text: |
            {
              "client_id": "{{clientId}}"
            }
        producedHeaders:
          - key: Authorization
            enabled: true
            value:
              type: expression
              value: '{{auth_type}} {{auth_token}}'
        authErrorCodes:
          - 401
          - 403
        deprecated: false
        type: auth
      - tags: []
        configuration: {}
        items:
          - documentation: Liveness probe — no auth required.
