                      'y': 60
                  - id: ef2d6919-693d-4559-8b68-a7fdf154a8b2
                    config:
                      code: |-
                        // `await` works: the body runs as an async function.
                        async function doubleAfterTick(n: number): Promise<number> {
                          await new Promise((r) => setTimeout(r, 5))
                          return n * 2
                        }
                        const doubled = await Promise.all(input.map((x) => doubleAfterTick(x.v)))
                        console.log('async doubled =', doubled.join(','))
                        return { doubled, asyncTotal: _.sum(doubled) }
                    inputs:
                      - id: in
                        name: ''
                        dataType: any
                        flow: signal
                      - id: value
                        name: input
                        dataType: any
                    kind: code
                    note: await Promise.all + setTimeout → async works
                    outputs:
                      - id: result
                        name: result
                        dataType: any
                        flow: both
                    position:
                      x: 300
                      'y': 380
                  - id: 2bfc137c-40db-48ae-a3a2-114895c7ef5a
