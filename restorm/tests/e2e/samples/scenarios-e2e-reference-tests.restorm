collections:
  - folderType: environment
    fileFormatVersion: 1
    tags:
      - auth
    tagColors: {}
    configuration: {}
    environments:
      - variables:
          - key: baseUrl
            enabled: true
            value:
              type: string
              value: http://localhost:5110
            description: ''
          - key: clientId
            enabled: true
            value:
              type: string
              value: VALID_CLIENT_ID
            description: ''
        id: 6c323ee6-0513-42a0-9d9a-68b329b405b4
        name: localhost
        subEnvironments:
          - variables: []
            id: env-1780300487228-md0ml0o
            name: Sub-env
            icon:
              type: phosphor
              value: ArrowFatLineDown
            color: '#bd10e0'
    items:
      - documentation: ''
        tags:
          - auth
        id: a1000000-0000-0000-0000-00000000auth
        name: Login
        method: POST
        url: '{{baseUrl}}/login?probe=1'
        headers:
          - key: Content-Type
            enabled: true
            value:
              type: string
              value: application/json
        params: []
        pathParams: []
        body:
          type: text
          content: '{"client_id":"{{clientId}}"}'
          contentType: application/json
        producedHeaders:
          - key: Authorization
            enabled: true
            value:
              type: expression
              value: '{{auth_type}} {{auth_token}}'
        authErrorCodes:
          - 401
          - 403
        deprecated: false
        type: auth
      - tags: []
        configuration: {}
        items:
          - documentation: Liveness probe — no auth required.
            tags: []
            id: d1000000-0000-0000-0000-00000000auth
            name: Health
            method: GET
            url: '{{baseUrl}}/health'
            headers: []
            params: []
            pathParams: []
            deprecated: false
            type: http
          - documentation: Requires the Login auth route.
            tags: []
            id: d2000000-0000-0000-0000-00000000auth
            name: Get Pet by Id
            authenticationRequestId: a1000000-0000-0000-0000-00000000auth
            method: GET
            url: '{{baseUrl}}/pet/1'
            headers:
              - key: Accept
                enabled: true
                value:
                  type: string
                  value: application/json
            params: []
            pathParams: []
            deprecated: false
            type: http
          - type: scenario
            tags: []
            params: []
