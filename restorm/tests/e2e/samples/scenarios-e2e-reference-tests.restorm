                        # `input` = wired value. sort + sum, return a named list.
                        nums <- sort(unlist(input))
                        total <- sum(nums)
                        cat(sprintf("r: total = %d\n", as.integer(total)))
                        list(total = as.integer(total), sorted = as.integer(nums))
                      language: r
