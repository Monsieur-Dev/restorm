                      nodeId: a9bec39a-6bbb-45cc-b267-867c80980fa0
                      portId: data
                items: []
                nodes:
                  - id: b332ea15-8e6d-483f-8eb0-b301d1bda8cb
                    config:
                      code: |-
                        // Fixed dataset (no input -> runs at start). Console.WriteLine -> run log.
                        var data = new List<Dictionary<string, object>> {
                            new() { ["n"] = "a", ["v"] = 3 },
                            new() { ["n"] = "b", ["v"] = 1 },
                            new() { ["n"] = "c", ["v"] = 2 },
                        };
                        Console.WriteLine($"csharp: built {data.Count} rows");
                        data
                      language: csharp
                    inputs:
                      - id: in
                        name: ''
                        dataType: any
                        flow: signal
                      - id: value
                        name: input
                        dataType: any
                    kind: code
                    outputs:
                      - id: result
                        name: result
                        dataType: any
                        flow: both
                    position:
                      x: -420
                      'y': 40
                  - id: 25d1f84e-0e13-4a97-a5f0-629f2d3a1494
                    config:
                      code: |-
                        // `input` = wired value (list of records). LINQ aggregate.
                        var rows = ((IEnumerable<object>)input).Cast<IDictionary<string, object>>().ToList();
                        long total = rows.Sum(r => Convert.ToInt64(r["v"]));
                        var names = rows.OrderBy(r => Convert.ToInt64(r["v"])).Select(r => (string)r["n"]).ToList();
                        Console.WriteLine($"csharp: total = {total} names = {string.Join(",", names)}");
                        new Dictionary<string, object> { ["total"] = total, ["names"] = names }
                      language: csharp
                    inputs:
                      - id: in
                        name: ''
                        dataType: any
                        flow: signal
                      - id: value
                        name: input
                        dataType: any
                    kind: code
                    outputs:
                      - id: result
                        name: result
                        dataType: any
                        flow: both
                    position:
                      x: 300
                      'y': 40
                  - id: b1eda16c-95c1-4b51-af6e-e22fb25e6048
                    config:
                      code: |-
                        // String summary of the previous result.
                        var names = (IEnumerable<object>)input["names"];
                        var summary = $"{names.Count()} items summing to {input["total"]}";
                        Console.WriteLine($"csharp: {summary}");
                        new Dictionary<string, object> { ["lang"] = "csharp", ["summary"] = summary, ["total"] = input["total"] }
                      language: csharp
                    inputs:
                      - id: in
                        name: ''
                        dataType: any
                        flow: signal
                      - id: value
                        name: input
                        dataType: any
                    kind: code
                    outputs:
                      - id: result
                        name: result
                        dataType: any
                        flow: both
                    position:
