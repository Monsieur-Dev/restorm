                      'y': 60
                  - id: ea7d7854-50ca-44a0-8346-f390486fd408
                    config:
                      code: |-
                        // TypeScript types are stripped before running in the QuickJS sandbox.
                        // `input` = wired value; curated stdlib available as globals.
                        const total: number = _.sumBy(input, 'v')
                        const names: string[] = _.map(_.sortBy(input, 'v'), 'n')
                        const hash = CryptoJS.MD5('restorm').toString().slice(0, 8)
                        console.log('total =', total, '| names =', names.join(','))
                        return { total, names, hash, momentType: typeof moment }
                      timeout: 5
                    inputs:
                      - id: in
                        name: ''
                        dataType: any
                        flow: signal
                      - id: value
                        name: input
                        dataType: any
                    kind: code
                    note: TS + lodash + crypto-js on the wired input → result object
                    outputs:
                      - id: result
                        name: result
                        dataType: any
                        flow: both
                    position:
                      x: 300
                      'y': 60
                  - id: 977b099d-6755-4163-9bd3-88caf723b0a1
