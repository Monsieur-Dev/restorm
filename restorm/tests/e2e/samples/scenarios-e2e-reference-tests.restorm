collections:
  - folderType: environment
    fileFormatVersion: 1
    tags:
      - auth
    tagColors: {}
    configuration: {}
    environments:
      - variables:
          - key: baseUrl
            enabled: true
            value:
              type: string
              value: http://localhost:5110
