collections:
  - folderType: environment
    fileFormatVersion: 1
    tags:
      - auth
    tagColors: {}
    configuration: {}
    environments:
      - variables:
          - key: baseUrl
            enabled: true
            value:
              type: string
              value: http://localhost:5110
            description: ''
          - key: clientId
            enabled: true
            value:
              type: string
              value: VALID_CLIENT_ID
            description: ''
        id: 6c323ee6-0513-42a0-9d9a-68b329b405b4
        name: localhost
        subEnvironments:
