fileFormatVersion: 1
collections:
  - id: a0000000-0000-0000-0000-00000000auth
    name: Auth Service
    folderType: environment
    configuration: {}
    customValueLists:
      - id: b0cd9e29-a779-4b49-a092-8b033ffb1674
        name: Pet Colors
        entries:
          - id: 96a8cf1a-17f7-4ea0-afda-f7a16b115dcd
            label: Rouge
            value: FF0000
          - id: 963ded6d-aabc-4a14-b6ea-2e06dcd1b535
            label: Vert
            value: 00FF00
          - id: 6d015220-3937-4878-9139-5193389a2f4f
            label: Bleu
            value: 0000FF
    environments:
      - id: 6c323ee6-0513-42a0-9d9a-68b329b405b4
        name: localhost
        subEnvironments:
          - id: env-1780300487228-md0ml0o
            name: Sub-env
            color: '#bd10e0'
            icon:
              type: phosphor
              value: ArrowFatLineDown
            variables: []
        variables:
          - key: baseUrl
            description: ''
            enabled: true
            value:
              type: string
              value: http://localhost:5110
          - key: clientId
            description: ''
            enabled: true
            value:
              type: string
              value: VALID_CLIENT_ID
          - key: socketUrl
            description: The Socket.IO server restorm hosts in-scenario (Echo Server)
            enabled: true
            value:
              type: string
              value: http://localhost:3001
    items:
      - id: a1000000-0000-0000-0000-00000000auth
        name: Login
        type: auth
        method: POST
        url: '{{baseUrl}}/login?probe=1'
        authErrorCodes:
          - 401
          - 403
        body:
          type: text
          content: '{"client_id":"{{clientId}}"}'
          contentType: application/json
        deprecated: false
        documentation: ''
        headers:
          - key: Content-Type
            enabled: true
            value:
              type: string
              value: application/json
        params: []
        pathParams: []
        producedHeaders:
          - key: Authorization
            enabled: true
            value:
              type: expression
              value: '{{auth_type}} {{auth_token}}'
        tags:
          - auth
      - id: f1000000-0000-0000-0000-00000000auth
        name: Pet API
        configuration: {}
        items:
          - id: d1000000-0000-0000-0000-00000000auth
            name: Health
            type: http
            method: GET
            url: '{{baseUrl}}/health'
            deprecated: false
            documentation: Liveness probe — no auth required.
            headers: []
            params: []
            pathParams: []
            tags: []
          - id: d2000000-0000-0000-0000-00000000auth
            name: Get Pet by Id
            type: http
            method: GET
            url: '{{baseUrl}}/pet/1'
            authenticationRequestId: a1000000-0000-0000-0000-00000000auth
            deprecated: false
            documentation: Requires the Login auth route.
            headers:
              - key: Accept
                enabled: true
                value:
                  type: string
                  value: application/json
            params: []
            pathParams: []
            tags: []
