                    headers: []
                    operationType: query
                    query: ''
                    resolverScript: |-
                      return {
                        Subscription: {
                          ticks: {
                            subscribe: async function* () {
                              yield 42
                              // Stay open after the first event so the CLIENT
                              // controls the stop (no timers — `setTimeout` is not
                              // in the resolver sandbox; a never-resolving promise
                              // suspends the generator until unsubscribe aborts it).
                              await new Promise(() => {})
                            },
                            resolve: (value) => value
                          }
                        }
                      }
                    schema: |-
                      type Query {
                        _: Boolean
                      }
                      type Subscription {
                        ticks: Int
                      }
                    server: true
                    tags:
                      - graphql
                      - server
