                    kind: log
                    outputs: []
                    position:
                      x: 920
                      'y': 380
                  - id: cb13efbd-530a-452e-b53f-b6914da1871e
                    config:
                      code: |-
                        // chai — fluent assertions. In Postman, `pm.expect(...)` IS chai's expect.
                        chai.expect(_.sum([1, 2, 3])).to.equal(6)
                        chai.expect('restorm').to.be.a('string').with.lengthOf(7)
                        expect([10, 20, 30]).to.include(20) // the bare `expect` alias works too
                        console.log('chai: 3 assertions passed')
                        return { library: 'chai', assertionsPassed: 3 }
                    inputs:
                      - id: in
                        name: ''
                        dataType: any
                        flow: signal
                      - id: value
                        name: input
                        dataType: any
                    kind: code
                    note: chai — Postman's pm.expect IS chai (v4)
                    outputs:
                      - id: result
                        name: result
                        dataType: any
                        flow: both
                    position:
                      x: -240
                      'y': 760
                  - id: 75c15a26-4438-47da-b0bd-3c267df0ce37
                    config:
                      code: |-
                        // cheerio — jQuery-style HTML/XML scraping (server-side).
                        const $ = cheerio.load('<ul><li class="first">one</li><li>two</li><li>three</li></ul>')
                        const items = $('li').map((i, el) => $(el).text()).get()
                        console.log('Cheerio items =', items.join(','))
                        return { library: 'cheerio', items, first: $('.first').text(), count: items.length }
                    inputs:
                      - id: in
                        name: ''
                        dataType: any
                        flow: signal
                      - id: value
                        name: input
                        dataType: any
                    kind: code
                    note: cheerio — jQuery-style HTML scraping
                    outputs:
                      - id: result
                        name: result
                        dataType: any
                        flow: both
                    position:
                      x: -240
                      'y': 1120
                  - id: cecd6dc3-d342-40a6-b1b7-fe58a05159e9
                    config:
                      code: |-
                        // xml2js — XML → JS object (async; exercises the events/timers shim).
                        const xml = '<catalog><book id="1"><title>Restorm</title></book><book id="2"><title>QuickJS</title></book></catalog>'
                        const parsed = await xml2js.parseStringPromise(xml)
                        const titles = parsed.catalog.book.map((b) => b.title[0])
                        console.log('xml2js titles =', titles.join(','))
                        return { library: 'xml2js', titles, count: parsed.catalog.book.length }
                    inputs:
                      - id: in
                        name: ''
                        dataType: any
                        flow: signal
                      - id: value
                        name: input
                        dataType: any
                    kind: code
                    note: xml2js — XML → JS (await, events/timers shim)
                    outputs:
                      - id: result
                        name: result
                        dataType: any
                        flow: both
                    position:
                      x: 680
                      'y': 760
                  - id: 4b83cb0a-ac2b-44f4-ab36-11fb035fbcf6
                    config:
                      code: |-
                        // Ajv + ajv-formats — JSON-schema validation with string formats.
                        const ajv = new Ajv()
                        ajvFormats(ajv)
                        const validate = ajv.compile({
                          type: 'object',
                          properties: { email: { type: 'string', format: 'email' }, when: { type: 'string', format: 'date' } },
                          required: ['email']
                        })
                        const ok = validate({ email: 'team@restorm.dev', when: '2026-01-01' })
                        const bad = validate({ email: 'not-an-email', when: '2026-01-01' })
                        console.log('ajv-formats: ok =', ok, '| bad =', bad)
                        return { library: 'ajv-formats', ok, bad }
                      language: typescript
                    inputs:
                      - id: in
                        name: ''
                        dataType: any
                        flow: signal
                      - id: value
                        name: input
                        dataType: any
                    kind: code
                    note: ajv-formats — JSON-schema validation w/ formats
                    outputs:
                      - id: result
                        name: result
                        dataType: any
                        flow: both
                    position:
                      x: 680
                      'y': 1120
                  - id: b288a934-4c8c-4830-9608-fc85f712dd16
                    config:
                      code: |-
                        // Postman-style call to the Auth Service health probe — runs through the
                        // restorm firewall (same network rules as an httpRequest node).
                        return await new Promise((resolve, reject) => {
                          pm.sendRequest({ url: 'http://localhost:5110/health', method: 'GET' }, (err, res) => {
                            if (err) { reject(err); return }
                            resolve({ status: res.code, body: res.text() })
                          })
                        })
                    inputs:
                      - id: in
                        name: ''
                        dataType: any
                        flow: signal
                      - id: value
                        name: input
                        dataType: any
                    kind: code
                    outputs:
                      - id: result
