            id: env-1780300487228-md0ml0o
            name: Sub-env
            icon:
              type: phosphor
              value: ArrowFatLineDown
            color: '#bd10e0'
    items:
      - documentation: ''
        tags:
          - auth
        id: a1000000-0000-0000-0000-00000000auth
        name: Login
        method: POST
        url: '{{baseUrl}}/login'
        headers:
          - key: Content-Type
            enabled: true
            value:
              type: string
              value: application/json
        params: []
        pathParams: []
        body:
          type: text
          contentType: application/json
          text: |
            {
              "client_id": "{{clientId}}"
            }
        producedHeaders:
          - key: Authorization
            enabled: true
            value:
              type: expression
              value: '{{auth_type}} {{auth_token}}'
        authErrorCodes:
          - 401
          - 403
        deprecated: false
        type: auth
      - tags: []
        configuration: {}
        items:
          - documentation: Liveness probe — no auth required.
            tags: []
            id: d1000000-0000-0000-0000-00000000auth
            name: Health
            method: GET
            url: '{{baseUrl}}/health'
            headers: []
            params: []
            pathParams: []
            deprecated: false
            type: http
          - documentation: Requires the Login auth route.
