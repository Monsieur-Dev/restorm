fileFormatVersion: 1
collections:
  - id: 6b0d7e3c-1f88-49b2-90ad-2b7c9e641f20
    name: gRPC Mock Playground
    folderType: environment
    configuration: {}
    environments:
      - id: 7c1f0a51-2c44-4d8e-9a01-7c3e26d40bb2
        name: Default
        variables: []
    items:
      - id: 8d2a1b90-5e77-4c10-bf21-0a9f3b613001
        name: Greeter Mock
        type: grpc
        method: ''
        url: localhost:50151
        callType: unary
        documentation: |-
          Hosts a local gRPC mock server on `localhost:50151`. Press Start, then
          run **Greeter Consumer**. Answers `mock.Greeter/SayHello` with a canned
          message and `mock.Greeter/Fail` with a NOT_FOUND status.
        metadata: []
        mockMethods:
          - method: SayHello
            callType: unary
            responseMessage: |-
              {
                "message": "hello from the restorm mock"
              }
            service: mock.Greeter
          - method: Fail
            callType: unary
            responseMessage: '{}'
            service: mock.Greeter
            statusCode: 5
            statusMessage: not here
        protoContent: |-
          syntax = "proto3";
          package mock;

          message HelloRequest { string name = 1; }
          message HelloReply { string message = 1; }
          message Empty {}

          service Greeter {
            rpc SayHello (HelloRequest) returns (HelloReply);
            rpc Fail (Empty) returns (Empty);
          }
        reflection: true
        requestMessage: ''
        server: true
        service: ''
        tags:
          - grpc
          - server
        transport: grpc
      - id: 8d2a1b90-5e77-4c10-bf21-0a9f3b613002
        name: Greeter Consumer
        type: grpc
        method: SayHello
        url: localhost:50151
        callType: unary
        documentation: Calls the local Greeter Mock SayHello and shows the canned response.
        metadata: []
        protoContent: |-
          syntax = "proto3";
          package mock;

          message HelloRequest { string name = 1; }
          message HelloReply { string message = 1; }
          message Empty {}

          service Greeter {
            rpc SayHello (HelloRequest) returns (HelloReply);
            rpc Fail (Empty) returns (Empty);
          }
        requestMessage: |-
          {
            "name": "world"
          }
        service: mock.Greeter
        tags:
          - grpc
        transport: grpc
      - id: 8d2a1b90-5e77-4c10-bf21-0a9f3b613003
        name: Greeter Error Consumer
        type: grpc
        method: Fail
        url: localhost:50151
        callType: unary
        documentation: Calls the local Greeter Mock Fail and shows the configured NOT_FOUND status.
        metadata: []
        protoContent: |-
          syntax = "proto3";
          package mock;

          message HelloRequest { string name = 1; }
          message HelloReply { string message = 1; }
          message Empty {}

          service Greeter {
            rpc SayHello (HelloRequest) returns (HelloReply);
            rpc Fail (Empty) returns (Empty);
          }
        requestMessage: '{}'
        service: mock.Greeter
        tags:
          - grpc
        transport: grpc
    tagColors: {}
    tags: []
_projectUuid: 4f7a2c19-8d44-4b6f-a1c2-9f0e5d738c33
