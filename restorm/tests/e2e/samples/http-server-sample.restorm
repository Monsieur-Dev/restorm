    environments:
      - id: 9b1f0a51-2c44-4d8e-9a01-7c3e26d40aa1
        name: Default
        variables: []
    items:
      - id: 6d2a1b90-5e77-4c10-bf21-0a9f3b612001
        name: Pets Mock
        type: http
        method: GET
        url: localhost:8099/pets
        body:
          type: text
          content: |-
            {
              "pets": [
                "Rex",
                "Whiskers"
              ]
            }
        deprecated: false
        documentation: |-
          Hosts a local HTTP mock server on `localhost:8099`. Press Listen, then
          run **Pets Consumer**. Answers `GET /pets` with status 200 + the body
          below.
        headers:
          - key: Content-Type
            enabled: true
            value:
              type: string
              value: application/json
        mockStatus: 200
        params: []
        pathParams: []
        server: true
        tags:
          - http
          - server
      - id: 6d2a1b90-5e77-4c10-bf21-0a9f3b612002
        name: Pets Consumer
        type: http
        method: GET
        url: http://localhost:8099/pets
        deprecated: false
        documentation: Calls the local Pets Mock and shows the configured response.
        headers: []
        params: []
        pathParams: []
        tags:
          - http
    tagColors: {}
    tags: []
