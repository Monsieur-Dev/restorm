-- {{ ctx.design.name }} — PostgreSQL schema generated by Restorm.
-- IDEMPOTENT: safe to play repeatedly. Table CREATEs come in
-- TOPOLOGICAL order (inheritance parents and referenced models first);
-- foreign keys are added afterwards under existence guards.
{#- ── shared helpers ─────────────────────────────────────────────── #}
{%- macro model_by_name(name) -%}{%- endmacro -%}
{%- set models_by_name = {} -%}
{%- for m in ctx.models -%}
  {%- set _ = models_by_name.update({m.name: m}) -%}
{%- endfor -%}
{#- all properties of a model, inherited chain first (flattened) -#}
{%- macro chain_names(model, acc) -%}
  {{- (chain_names(models_by_name[model.inherits], acc) if 'inherits' in model and model.inherits in models_by_name else '') -}}
  {{- acc.append(model.name) or '' -}}
{%- endmacro -%}
{%- macro table_name(model) -%}{{ model.name | lower }}{%- endmacro -%}
{%- macro col_type(p) -%}
  {%- if 'enum' in p -%}"{{ p.enum | lower }}"
  {%- elif 'references' in p -%}{{ id_sql_type(models_by_name[p.references.model]) }}
  {%- elif p.type == 'integer' -%}{% if 'format' in p and p.format == 'int64' %}bigint{% else %}integer{% endif %}
  {%- elif p.type == 'number' -%}double precision
  {%- elif p.type == 'boolean' -%}boolean
  {%- elif p.type == 'array' -%}{% if 'arrayOf' in p and p.arrayOf == 'integer' %}bigint[]{% elif 'arrayOf' in p and p.arrayOf == 'number' %}double precision[]{% elif 'arrayOf' in p and p.arrayOf == 'boolean' %}boolean[]{% else %}text[]{% endif %}
  {%- elif p.type == 'map' or p.type == 'any' -%}jsonb
  {%- elif 'format' in p and p.format == 'uuid' -%}uuid
  {%- elif 'format' in p and p.format == 'date-time' -%}timestamptz
  {%- elif 'format' in p and p.format == 'date' -%}date
  {%- else -%}text
  {%- endif -%}
{%- endmacro -%}
{#- the identifier column of a model (inherited chain aware) -#}
{%- macro id_prop(model) -%}
  {%- set ns = namespace(found=none) -%}
  {%- set chain = [] -%}{{- chain_names(model, chain) -}}
  {%- for name in chain -%}
    {%- set m = models_by_name[name] -%}
    {%- if ns.found is none and 'identifier' in m -%}
      {%- for p in m.properties -%}{%- if p.name == m.identifier.property -%}{%- set ns.found = p -%}{%- endif -%}{%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if ns.found is not none -%}{{ ns.found.name }}{%- else -%}id{%- endif -%}
{%- endmacro -%}
{%- macro id_sql_type(model) -%}
  {%- set ns = namespace(t='text') -%}
  {%- set chain = [] -%}{{- chain_names(model, chain) -}}
  {%- for name in chain -%}
    {%- set m = models_by_name[name] -%}
    {%- if 'identifier' in m -%}
      {%- if m.identifier.strategy == 'uuid' -%}{%- set ns.t = 'uuid' -%}
      {%- elif m.identifier.strategy == 'autoIncrement' -%}{%- set ns.t = 'bigint' -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {{- ns.t -}}
{%- endmacro -%}
{#- ── enum types (guarded — CREATE TYPE has no IF NOT EXISTS) ────── #}
{% for enum in ctx.enums %}

DO $$ BEGIN
  CREATE TYPE "{{ enum.name | lower }}" AS ENUM ({% for v in enum['values'] %}{% if not loop.first %}, {% endif %}'{{ (v | string) | replace("'", "''") }}'{% endfor %});
EXCEPTION WHEN duplicate_object THEN NULL; END $$;
{% endfor %}
{#- ── topological order: inheritance parents + referenced models first #}
{%- set ns = namespace(order=[]) -%}
{%- for _i in range(ctx.models | length) -%}
  {%- for m in ctx.models -%}
    {%- if m.name not in ns.order -%}
      {%- set deps = [] -%}
      {%- if 'inherits' in m and m.inherits != m.name -%}{%- set _ = deps.append(m.inherits) -%}{%- endif -%}
      {%- for p in m.properties -%}
        {%- if 'references' in p and p.references.model != m.name -%}{%- set _ = deps.append(p.references.model) -%}{%- endif -%}
      {%- endfor -%}
      {%- if deps | reject('in', ns.order) | list | length == 0 -%}
        {%- set ns.order = ns.order + [m.name] -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{# cycle fallback: whatever remains is appended (FKs are guarded later anyway) #}
{%- for m in ctx.models -%}{%- if m.name not in ns.order -%}{%- set ns.order = ns.order + [m.name] -%}{%- endif -%}{%- endfor %}
{#- ── tables ─────────────────────────────────────────────────────── #}
{% for model_name in ns.order %}
{% set model = models_by_name[model_name] %}
{% set chain = [] %}{{ chain_names(model, chain) -}}
{% set pk = id_prop(model) %}

CREATE TABLE IF NOT EXISTS "{{ table_name(model) }}" (
{% for owner_name in chain %}
{% set owner = models_by_name[owner_name] %}
{% for p in owner.properties %}
  "{{ p.name }}" {{ col_type(p) }}{% if p.name == pk %}{% if id_sql_type(model) == 'uuid' %} PRIMARY KEY DEFAULT gen_random_uuid(){% elif id_sql_type(model) == 'bigint' and 'identifier' in owner and owner.identifier.strategy == 'autoIncrement' %} GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY{% else %} PRIMARY KEY{% endif %}{% else %}{% if p.required and 'references' not in p %} NOT NULL{% endif %}{% if 'default' in p %} DEFAULT {% if p.default is string %}'{{ p.default | replace("'", "''") }}'{% else %}{{ p.default | tojson }}{% endif %}{% endif %}{% if 'unique' in p %} UNIQUE{% endif %}{% endif %},
{% endfor %}
{% endfor %}
{% if 'timestamps' in model %}
  "created_at" timestamptz NOT NULL DEFAULT now(),
  "updated_at" timestamptz NOT NULL DEFAULT now(),
{% endif %}
{% if 'softDelete' in model %}
  "deleted_at" timestamptz,
{% endif %}
  CONSTRAINT "{{ table_name(model) }}_generated_by_restorm" CHECK (true)
);
{# CHECK constraints from the validations (guarded, named) #}
{% for owner_name in chain %}
{% set owner = models_by_name[owner_name] %}
{% for p in owner.properties %}
{% if 'constraints' in p %}
{% set c = p.constraints %}
DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = '{{ table_name(model) }}_{{ p.name }}_check') THEN
    ALTER TABLE "{{ table_name(model) }}" ADD CONSTRAINT "{{ table_name(model) }}_{{ p.name }}_check" CHECK (
      true
{% if 'minLength' in c %}      AND char_length("{{ p.name }}") >= {{ c.minLength }}
{% endif %}
{% if 'maxLength' in c %}      AND char_length("{{ p.name }}") <= {{ c.maxLength }}
{% endif %}
{% if 'pattern' in c %}      AND "{{ p.name }}" ~ '{{ c.pattern | replace("'", "''") }}'
{% endif %}
{% if 'minimum' in c %}      AND "{{ p.name }}" >{% if not ('exclusiveMinimum' in c and c.exclusiveMinimum is true) %}={% endif %} {{ c.minimum }}
{% endif %}
{% if 'maximum' in c %}      AND "{{ p.name }}" <{% if not ('exclusiveMaximum' in c and c.exclusiveMaximum is true) %}={% endif %} {{ c.maximum }}
{% endif %}
    );
  END IF;
END $$;
{% endif %}
{% endfor %}
{% endfor %}
{# indexes from the searchable intention #}
{% for owner_name in chain %}
{% set owner = models_by_name[owner_name] %}
{% for p in owner.properties %}
{% if 'searchable' in p %}
CREATE INDEX IF NOT EXISTS "{{ table_name(model) }}_{{ p.name }}_idx" ON "{{ table_name(model) }}" ("{{ p.name }}");
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
{# ── foreign keys (after every table, guarded) ─────────────────── #}
{% for model_name in ns.order %}
{% set model = models_by_name[model_name] %}
{% set chain = [] %}{{ chain_names(model, chain) -}}
{% for owner_name in chain %}
{% set owner = models_by_name[owner_name] %}
{% for p in owner.properties %}
{% if 'references' in p and 'array' not in p.references %}
{% set target = models_by_name[p.references.model] %}
DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = '{{ table_name(model) }}_{{ p.name }}_fkey') THEN
    ALTER TABLE "{{ table_name(model) }}" ADD CONSTRAINT "{{ table_name(model) }}_{{ p.name }}_fkey"
      FOREIGN KEY ("{{ p.name }}") REFERENCES "{{ table_name(target) }}" ("{{ id_prop(target) }}"){% if 'onDelete' in p.references and p.references.onDelete == 'cascade' %} ON DELETE CASCADE{% elif 'onDelete' in p.references and p.references.onDelete == 'setNull' %} ON DELETE SET NULL{% endif %};
  END IF;
END $$;
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
{# ── junction tables for n-n relations (last: both ends exist) ─── #}
{% for model_name in ns.order %}
{% set model = models_by_name[model_name] %}
{% set chain = [] %}{{ chain_names(model, chain) -}}
{% for owner_name in chain %}
{% set owner = models_by_name[owner_name] %}
{% for p in owner.properties %}
{% if 'references' in p and 'array' in p.references %}
{% set target = models_by_name[p.references.model] %}
CREATE TABLE IF NOT EXISTS "{{ table_name(model) }}_{{ p.name }}" (
  "{{ table_name(model) }}_{{ id_prop(model) }}" {{ id_sql_type(model) }} NOT NULL REFERENCES "{{ table_name(model) }}" ("{{ id_prop(model) }}"){% if 'onDelete' in p.references and p.references.onDelete == 'cascade' %} ON DELETE CASCADE{% endif %},
  "{{ table_name(target) }}_{{ id_prop(target) }}" {{ id_sql_type(target) }} NOT NULL REFERENCES "{{ table_name(target) }}" ("{{ id_prop(target) }}"),
  PRIMARY KEY ("{{ table_name(model) }}_{{ id_prop(model) }}", "{{ table_name(target) }}_{{ id_prop(target) }}")
);
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
