fileFormatVersion: 1
collections:
  - id: envf-0000-0000-0000-000000000001
    name: PetAPI
    folderType: environment
    configuration: {}
    environments:
      - id: env-0000-0000-0000-000000000001
        name: Dev
        variables:
          - key: baseUrl
            description: ''
            enabled: true
            value:
              type: string
              value: http://localhost:8080
          - key: petStatus
            description: ''
            enabled: true
            value:
              type: enum
              value: available
              enumDefinitionId: enum-0000-0000-0000-000000000001
        subEnvironments:
          - id: subenv-0000-0000-0000-000000000001
            name: Staging
            variables:
              - key: baseUrl
                description: ''
                enabled: true
