{
  "openapi": "3.1.0",
  "info": {
    "title": "Petstore 3.1",
    "summary": "3.1 sample with nullable, plural examples, and webhooks",
    "version": "1.0.0",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "servers": [{ "url": "https://petstore31.swagger.io/api/v3" }],
  "tags": [{ "name": "pet" }],
  "paths": {
    "/pet/{petId}": {
      "get": {
        "tags": ["pet"],
        "operationId": "getPetById31",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": ["integer", "null"], "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } }
            }
          }
        }
      }
    }
  },
  "webhooks": {
    "petStatusChanged": {
      "post": {
        "operationId": "petStatusChangedWebhook",
        "summary": "Notification fired when a pet's status changes",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } }
          }
        },
        "responses": { "200": { "description": "Acknowledged" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "properties": {
          "id": { "type": ["integer", "null"] },
          "name": { "type": "string" },
          "tag": {
            "type": "string",
            "examples": ["good-boy", "puppy"]
          }
        }
      }
    }
  }
}
