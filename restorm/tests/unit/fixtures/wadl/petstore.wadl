<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<application xmlns="http://wadl.dev.java.net/2009/02">
  <doc xmlns:jersey="http://jersey.java.net/" jersey:generatedBy="Jersey: 2.35 2021-11-09"/>
  <grammars>
    <schema elementFormDefault="qualified" attributeFormDefault="unqualified"
      xmlns:tns="http://petstore.example.com/" targetNamespace="http://petstore.example.com/"
      xmlns="http://www.w3.org/2001/XMLSchema">
      <element name="pet" type="tns:pet"/>
      <complexType name="pet">
        <sequence>
          <element name="id" type="xs:long" minOccurs="0"/>
          <element name="name" type="xs:string"/>
          <element name="status" type="xs:string" minOccurs="0"/>
        </sequence>
      </complexType>
      <import namespace="http://petstore.example.com/order" schemaLocation="order.xsd"/>
    </schema>
  </grammars>
  <resources base="http://petstore.example.com/api/">
    <resource path="pets">
      <method name="GET" id="getPets">
        <request>
          <param name="status" style="query" type="xs:string"/>
        </request>
        <response>
          <representation mediaType="application/json"/>
        </response>
      </method>
      <method name="POST" id="createPet">
        <request>
          <representation mediaType="application/json" element="tns:pet"/>
        </request>
        <response>
          <representation mediaType="application/json"/>
        </response>
      </method>
      <resource path="{id}">
        <param name="id" style="template" type="xs:long"/>
        <method name="GET" id="getPetById">
          <response>
            <representation mediaType="application/json"/>
          </response>
        </method>
        <method name="DELETE" id="deletePet">
          <request>
            <param name="X-Api-Key" style="header" type="xs:string"/>
          </request>
        </method>
      </resource>
    </resource>
  </resources>
</application>
