{
  "pawVersion": 3,
  "requestGroups": {
    "grp-pets": {
      "id": "grp-pets",
      "name": "Pets",
      "parentId": null,
      "order": 0
    }
  },
  "requests": {
    "req-get-pet": {
      "id": "req-get-pet",
      "name": "Get pet by id",
      "method": "GET",
      "urlBase": "http://localhost:8080/v2/pet/1",
      "urlParameters": [
        {
          "key": "traceId",
          "value": { "$class": "com.luckymarmot.DynamicValue", "type": "com.luckymarmot.UUIDDynamicValue" }
        },
        {
          "key": "sessionCookie",
          "value": { "$class": "com.luckymarmot.DynamicValue", "type": "com.luckymarmot.CookieJarDynamicValue" }
        }
      ],
      "headers": [
        { "key": "Accept", "value": "application/json" },
        {
          "key": "X-Request-Id",
          "value": { "$class": "com.luckymarmot.DynamicValue", "type": "com.luckymarmot.RandomStringDynamicValue" }
        },
        {
          "key": "X-Timestamp",
          "value": { "$class": "com.luckymarmot.DynamicValue", "type": "com.luckymarmot.TimestampDynamicValue" }
        }
      ],
      "description": "Fetch a pet by id.",
      "parentId": "grp-pets",
      "order": 0
    },
    "req-create-pet": {
      "id": "req-create-pet",
      "name": "Create pet",
      "method": "POST",
      "urlBase": "http://localhost:8080/v2/pet",
      "headers": [{ "key": "Content-Type", "value": "application/json" }],
      "body": {
        "type": "json",
        "value": "{\"name\": \"Fido\", \"status\": \"available\"}"
      },
      "parentId": "grp-pets",
      "order": 1
    }
  },
  "environments": {
    "env-prod": {
      "id": "env-prod",
      "name": "Production",
      "variables": {
        "baseUrl": "http://localhost:8080/v2",
        "apiKey": { "$class": "com.luckymarmot.DynamicValue", "type": "com.luckymarmot.RandomStringDynamicValue" }
      }
    }
  }
}
