  - folderType: environment
    name: gRPC Docker
    documentation: |-
      # gRPC Docker

      gRPC API

      ## Messages

      ### HelloRequest
        - greeting: string

      ### HelloResponse
        - reply: string

      ### HeadersResponse


      ### IndexResponse
        - services: repeated string

      ### DummyMessage
        - f_string: string
        - f_strings: repeated string
        - f_int32: int32
        - f_int32s: repeated int32

      ### SubMessage
        - f_string: string

      ### SpecificErrorRequest
        - code: int32

      ### AddrResponse
        - addr: string
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables:
          - key: baseUrl
            value:
              type: string
              value: localhost:9000
    items:
      - name: HelloService
        documentation: Hello service - simple greeting
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            name: SayHello
            documentation: Say hello
            tags:
              - unary
            url: localhost:9000
            service: grpcbin.HelloService
            method: SayHello
            callType: unary
            requestMessage: |-
              {
                "greeting": ""
              }
            metadata: []
      - name: HeadersService
        documentation: Headers service - echo headers
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            name: GetHeaders
            documentation: Returns request headers
            tags:
              - unary
            url: localhost:9000
            service: grpcbin.HeadersService
            method: GetHeaders
            callType: unary
            requestMessage: '{}'
            metadata: []
      - name: IndexService
        documentation: Index service - list available services
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            name: GetIndex
            documentation: Get server index
            tags:
              - unary
            url: localhost:9000
            service: grpcbin.IndexService
            method: GetIndex
            callType: unary
            requestMessage: '{}'
            metadata: []
      - name: DummyService
        documentation: DummyMessage service - generate dummy messages
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            name: DummyUnary
            documentation: Unary call
            tags:
              - unary
            url: localhost:9000
            service: grpcbin.DummyService
            method: DummyUnary
            callType: unary
            requestMessage: |-
              {
                "f_string": "",
                "f_strings": [
                  ""
                ],
                "f_int32": 0,
                "f_int32s": [
                  0
                ]
              }
            metadata: []
          - type: grpc
            name: DummyServerStream
            documentation: Server streaming
            tags:
              - server-stream
            url: localhost:9000
            service: grpcbin.DummyService
            method: DummyServerStream
            callType: server-stream
            requestMessage: |-
              {
                "f_string": "",
                "f_strings": [
                  ""
                ],
                "f_int32": 0,
                "f_int32s": [
                  0
                ]
              }
            metadata: []
          - type: grpc
            name: DummyClientStream
            documentation: Client streaming
            tags:
              - client-stream
            url: localhost:9000
            service: grpcbin.DummyService
            method: DummyClientStream
            callType: client-stream
            requestMessage: |-
              {
                "f_string": "",
                "f_strings": [
                  ""
                ],
                "f_int32": 0,
                "f_int32s": [
                  0
                ]
              }
            metadata: []
          - type: grpc
            name: DummyBidirectionalStream
            documentation: Bidirectional streaming
            tags:
              - bidirectional-stream
            url: localhost:9000
            service: grpcbin.DummyService
            method: DummyBidirectionalStream
            callType: bidirectional-stream
            requestMessage: |-
              {
                "f_string": "",
                "f_strings": [
                  ""
                ],
                "f_int32": 0,
                "f_int32s": [
                  0
                ]
              }
