  - folderType: environment
    name: gRPC Petstore
    documentation: |-
      # gRPC Petstore

      gRPC API

      ## Messages

      ### Category
        - id: int64
        - name: string

      ### Tag
        - id: int64
        - name: string

      ### Pet
        - id: int64
        - name: string
        - category: Category
        - photo_urls: repeated string
        - tags: repeated Tag
        - status: PetStatus

      ### Order
        - id: int64
        - pet_id: int64
        - quantity: int32
        - ship_date: string
        - status: OrderStatus
        - complete: bool

      ### User
        - id: int64
        - username: string
        - first_name: string
        - last_name: string
        - email: string
        - password: string
        - phone: string
        - user_status: int32

      ### GetPetRequest
        - id: int64

      ### ListPetsRequest
        - status: repeated PetStatus
        - tags: repeated string
        - limit: int32
        - offset: int32

      ### ListPetsResponse
        - pets: repeated Pet
        - total: int32

      ### CreatePetRequest
        - name: string
        - category: Category
        - photo_urls: repeated string
        - tags: repeated Tag
        - status: PetStatus

      ### UpdatePetRequest
        - id: int64
        - name: string
        - category: Category
        - photo_urls: repeated string
        - tags: repeated Tag
        - status: PetStatus

      ### DeletePetRequest
        - id: int64

      ### DeletePetResponse
        - success: bool

      ### StreamPetUpdatesRequest
        - status_filter: repeated PetStatus

      ### PetUpdate
        - event_type: string
        - pet: Pet
        - timestamp: string

      ### GetInventoryResponse


      ### PlaceOrderRequest
        - pet_id: int64
        - quantity: int32
        - ship_date: string

      ### GetOrderRequest
        - id: int64

      ### DeleteOrderRequest
        - id: int64

      ### DeleteOrderResponse
        - success: bool

      ### CreateUserRequest
        - username: string
        - first_name: string
        - last_name: string
        - email: string
        - password: string
        - phone: string

      ### GetUserRequest
        - username: string

      ### UpdateUserRequest
        - username: string
        - first_name: string
        - last_name: string
        - email: string
        - password: string
        - phone: string

      ### DeleteUserRequest
        - username: string

      ### DeleteUserResponse
        - success: bool

      ### LoginRequest
        - username: string
        - password: string

      ### LoginResponse
        - token: string
        - expires_at: string

      ### LogoutRequest
        - token: string

      ### LogoutResponse
        - success: bool
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables:
          - key: baseUrl
            value:
              type: string
              value: localhost:9000
    items:
      - name: PetService
        documentation: Pet service for managing pets in the store
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            name: GetPet
            documentation: Get a single pet by ID
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: GetPet
            callType: unary
            requestMessage: |-
              {
                "id": 0
              }
            metadata: []
          - type: grpc
            name: ListPets
            documentation: List all pets with optional filtering
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: ListPets
            callType: unary
            requestMessage: |-
              {
                "status": [
                  {}
                ],
                "tags": [
                  ""
                ],
                "limit": 0,
                "offset": 0
              }
            metadata: []
          - type: grpc
            name: CreatePet
            documentation: Create a new pet
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: CreatePet
            callType: unary
            requestMessage: |-
              {
                "name": "",
                "category": {},
                "photo_urls": [
                  ""
                ],
                "tags": [
                  {}
                ],
                "status": {}
              }
            metadata: []
          - type: grpc
            name: UpdatePet
            documentation: Update an existing pet
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: UpdatePet
            callType: unary
            requestMessage: |-
              {
                "id": 0,
                "name": "",
                "category": {},
                "photo_urls": [
                  ""
                ],
                "tags": [
                  {}
                ],
                "status": {}
              }
            metadata: []
          - type: grpc
            name: DeletePet
            documentation: Delete a pet
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: DeletePet
            callType: unary
            requestMessage: |-
              {
                "id": 0
              }
            metadata: []
          - type: grpc
            name: StreamPetUpdates
            documentation: Stream pet updates in real-time
            tags:
              - server-stream
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: StreamPetUpdates
            callType: server-stream
            requestMessage: |-
              {
                "status_filter": [
                  {}
                ]
              }
            metadata: []
      - name: StoreService
        documentation: Store service for managing orders
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            name: GetInventory
            documentation: Get store inventory
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.StoreService
            method: GetInventory
            callType: unary
            requestMessage: '{}'
            metadata: []
          - type: grpc
            name: PlaceOrder
            documentation: Place an order
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.StoreService
            method: PlaceOrder
            callType: unary
            requestMessage: |-
              {
                "pet_id": 0,
                "quantity": 0,
                "ship_date": ""
              }
            metadata: []
          - type: grpc
            name: GetOrder
            documentation: Get an order by ID
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.StoreService
            method: GetOrder
            callType: unary
            requestMessage: |-
              {
                "id": 0
              }
            metadata: []
          - type: grpc
            name: DeleteOrder
            documentation: Delete an order
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.StoreService
            method: DeleteOrder
            callType: unary
            requestMessage: |-
              {
                "id": 0
              }
            metadata: []
      - name: UserService
        documentation: User service for managing users
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            name: CreateUser
            documentation: Create a new user
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.UserService
            method: CreateUser
            callType: unary
            requestMessage: |-
              {
                "username": "",
                "first_name": "",
                "last_name": "",
                "email": "",
                "password": "",
                "phone": ""
              }
            metadata: []
          - type: grpc
            name: GetUser
            documentation: Get user by username
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.UserService
            method: GetUser
            callType: unary
            requestMessage: |-
              {
                "username": ""
              }
            metadata: []
          - type: grpc
            name: UpdateUser
            documentation: Update user
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.UserService
            method: UpdateUser
            callType: unary
            requestMessage: |-
              {
                "username": "",
                "first_name": "",
                "last_name": "",
                "email": "",
                "password": "",
                "phone": ""
              }
            metadata: []
          - type: grpc
            name: DeleteUser
            documentation: Delete user
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.UserService
            method: DeleteUser
            callType: unary
            requestMessage: |-
              {
                "username": ""
              }
            metadata: []
          - type: grpc
            name: Login
            documentation: Login user
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.UserService
            method: Login
            callType: unary
            requestMessage: |-
              {
                "username": "",
                "password": ""
              }
            metadata: []
          - type: grpc
            name: Logout
            documentation: Logout user
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.UserService
            method: Logout
            callType: unary
            requestMessage: |-
              {
                "token": ""
              }
            metadata: []
