                </soap:Body>
              </soap:Envelope>
            headers:
              - key: Content-Type
                value:
                  type: string
                  value: text/xml; charset=utf-8
                description: ''
                enabled: true
              - key: SOAPAction
                value:
                  type: string
                  value: http://restorm.test/castlemock/Echo
                description: ''
                enabled: true
