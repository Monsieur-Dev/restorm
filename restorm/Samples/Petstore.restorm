  - folderType: environment
    id: 119630aa-0024-4000-8000-119630aa1196
    name: AsyncAPI Docker
    documentation: |-
      # AsyncAPI Docker

      AsyncAPI specification for Docker test services.
      Covers Socket.IO and MQTT endpoints.


      Version: 1.0.0
    tags: []
    configuration: {}
    environments:
      - id: 5641a9aa-0024-4000-8000-5641a9aa5641
        name: Default
        variables:
          - key: baseUrl
            value: localhost:1883
    items:
      - id: 1193f2ec-0024-4000-8000-1193f2ec1193
        name: MQTT
        documentation: |-
          # MQTT Channels

          Message broker pub/sub
        tags:
          - mqtt
        configuration: {}
        items:
          - type: websocket
            id: 3eebde4f-0024-4000-8000-3eebde4f3eeb
            name: mqttPublishEcho
            documentation: Publish test message
            tags:
              - publish
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: test/echo
            message: '{}'
            headers: []
          - type: websocket
            id: 6609c5ac-0026-4000-8000-6609c5ac6609
            name: mqttSubscribeEcho
            documentation: Subscribe to test messages
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: test/echo
            message: '{}'
            headers: []
          - type: websocket
            id: 3ee95b8c-0024-4000-8000-3ee95b8c3ee9
            name: mqttPublishJson
            documentation: Publish JSON message
            tags:
              - publish
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: test/json
            message: '{}'
            headers: []
          - type: websocket
            id: 660c486f-0026-4000-8000-660c486f660c
            name: mqttSubscribeJson
            documentation: Subscribe to JSON messages
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: test/json
            message: '{}'
            headers: []
          - type: websocket
            id: 76fa123b-0032-4000-8000-76fa123b76fa
            name: mqttPublishSensorData
            documentation: Publish sensor data
            tags:
              - publish
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: sensors/{sensorId}/data
            message: |-
              {
                "sensorId": "",
                "value": 0,
                "unit": "",
                "timestamp": ""
              }
            headers: []
          - type: websocket
            id: 53fc8180-0034-4000-8000-53fc818053fc
            name: mqttSubscribeSensorData
            documentation: Subscribe to sensor data
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: sensors/{sensorId}/data
            message: |-
              {
                "sensorId": "",
                "value": 0,
                "unit": "",
                "timestamp": ""
              }
            headers: []
          - type: websocket
            id: 6528d0c8-0036-4000-8000-6528d0c86528
            name: mqttSubscribeDeviceStatus
            documentation: Subscribe to device status updates
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: devices/{deviceId}/status
            message: |-
              {
                "deviceId": "",
                "online": false,
                "lastSeen": "",
                "battery": 0
              }
            headers: []
      - id: 5771a7a1-0028-4000-8000-5771a7a15771
        name: Socket.IO
        documentation: |-
          # Socket.IO Events

          Real-time bidirectional communication
        tags:
          - socketio
        configuration: {}
