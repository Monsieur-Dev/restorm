  - folderType: environment
    name: AsyncAPI Docker
    documentation: |-
      # AsyncAPI Docker

      AsyncAPI specification for Docker test services.
      Covers Socket.IO and MQTT endpoints.


      Version: 1.0.0
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables:
          - key: baseUrl
            value:
              type: string
              value: localhost:1883
    items:
      - name: MQTT
        documentation: |-
          # MQTT Channels

          Message broker pub/sub
        tags:
          - mqtt
        configuration: {}
        items:
          - type: websocket
            name: mqttPublishEcho
            documentation: Publish test message
            tags:
              - publish
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: test/echo
            message: '{}'
            headers:
              - key: s
                value:
                  type: string
                  value: s
                description: ''
                enabled: true
            notes: |
              ugg
          - type: websocket
            name: mqttSubscribeEcho
            documentation: Subscribe to test messages
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: test/echo
            message: '{}'
            headers: []
          - type: websocket
            name: mqttPublishJson
            documentation: Publish JSON message
            tags:
              - publish
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: test/json
            message: '{}'
            headers: []
          - type: websocket
            name: mqttSubscribeJson
            documentation: Subscribe to JSON messages
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: test/json
            message: '{}'
            headers: []
          - type: websocket
            name: mqttPublishSensorData
            documentation: Publish sensor data
            tags:
              - publish
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: sensors/{sensorId}/data
            message: |-
              {
                "sensorId": "",
                "value": 0,
                "unit": "",
                "timestamp": ""
              }
            headers: []
          - type: websocket
            name: mqttSubscribeSensorData
            documentation: Subscribe to sensor data
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: sensors/{sensorId}/data
            message: |-
              {
                "sensorId": "",
                "value": 0,
                "unit": "",
                "timestamp": ""
              }
            headers: []
          - type: websocket
            name: mqttSubscribeDeviceStatus
            documentation: Subscribe to device status updates
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: devices/{deviceId}/status
            message: |-
              {
                "deviceId": "",
                "online": false,
                "lastSeen": "",
                "battery": 0
              }
            headers: []
      - name: Socket.IO
        documentation: |-
          # Socket.IO Events

          Real-time bidirectional communication
        tags:
          - socketio
        configuration: {}
        items:
          - type: websocket
            name: sendEcho
            documentation: Send data to be echoed
            tags:
              - publish
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: echo
            message: '{}'
            headers: []
            notes: ''
          - type: websocket
            name: receiveEcho
            documentation: Receive echoed data
            tags:
              - subscribe
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: echo
            message: '{}'
            headers: []
          - type: websocket
            name: sendPing
            documentation: Send ping
            tags:
              - publish
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: ping
            message: '{}'
            headers: []
          - type: websocket
            name: receivePong
            documentation: Receive pong with timestamp
            tags:
              - subscribe
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: pong
            message: |-
              {
                "timestamp": 0
              }
            headers: []
          - type: websocket
            name: sendBroadcast
            documentation: Send broadcast message
            tags:
              - publish
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: broadcast
            message: '{}'
            headers: []
          - type: websocket
            name: receiveBroadcast
            documentation: Receive broadcast from any client
            tags:
              - subscribe
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: broadcast
            message: |-
              {
                "from": "",
                "data": {},
                "timestamp": 0
              }
            headers: []
          - type: websocket
            name: joinRoom
            documentation: Join a room by name
            tags:
              - publish
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: join-room
            message: '{}'
            headers: []
          - type: websocket
            name: onJoined
            documentation: Confirmation of room join
            tags:
              - subscribe
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: joined
            message: |-
              {
                "room": ""
              }
            headers: []
          - type: websocket
            name: leaveRoom
            documentation: Leave a room by name
            tags:
              - publish
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: leave-room
            message: '{}'
            headers: []
          - type: websocket
            name: onLeft
            documentation: Confirmation of room leave
            tags:
              - subscribe
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: left
            message: |-
              {
                "room": ""
              }
            headers: []
          - type: websocket
            name: sendRoomMessage
            documentation: Send message to a room
            tags:
              - publish
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: room-message
            message: |-
              {
                "room": "",
                "message": ""
              }
            headers: []
          - type: websocket
            name: receiveRoomMessage
            documentation: Receive message from a room
            tags:
              - subscribe
              - socketio
            url: ws://localhost:3001
            protocol: socketio
            event: room-message
            message: |-
              {
                "from": "",
                "room": "",
                "message": "",
                "timestamp": 0
              }
            headers: []
  - folderType: environment
    name: AsyncAPI Petstore
    documentation: |-
      # AsyncAPI Petstore

      AsyncAPI specification for the Petstore.
      Covers MQTT and Socket.IO event-driven operations.


      Version: 1.0.0
    tags: []
    configuration: {}
    environments:
      - name: Default
        variables:
          - key: baseUrl
            value:
              type: string
              value: localhost:1883
    items:
      - name: MQTT
        documentation: |-
          # MQTT Channels

          Message broker pub/sub
        tags:
          - mqtt
        configuration: {}
        items:
          - type: websocket
            name: onPetCreated
            documentation: Receive notifications when a new pet is created
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: pet/created
            message: '{}'
            headers: []
          - type: websocket
            name: onPetUpdated
            documentation: Receive notifications when a pet is updated
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: pet/updated
            message: '{}'
            headers: []
          - type: websocket
            name: onPetDeleted
            documentation: Receive notifications when a pet is deleted
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: pet/deleted
            message: |-
              {
                "petId": 0,
                "timestamp": ""
              }
            headers: []
          - type: websocket
            name: onPetStatusChange
            documentation: Receive notifications for pets with specific status
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: pet/status/{status}
            message: '{}'
            headers: []
          - type: websocket
            name: onOrderPlaced
            documentation: Receive notifications when a new order is placed
            tags:
              - subscribe
              - mqtt
            url: mqtt://localhost:1883
            protocol: mqtt
            event: order/placed
            message: '{}'
            headers: []
          - type: websocket
            name: onOrderStatusUpdate
            documentation: Receive status updates for a specific order
            tags:
