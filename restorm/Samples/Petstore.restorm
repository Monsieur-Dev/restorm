  - folderType: environment
    id: 09dcfa48-001e-4000-8000-09dcfa4809dc
    name: gRPC Petstore
    documentation: |-
      # gRPC Petstore

      gRPC API

      ## Messages

      ### Category
        - id: int64
        - name: string

      ### Tag
        - id: int64
        - name: string

      ### Pet
        - id: int64
        - name: string
        - category: Category
        - photo_urls: repeated string
        - tags: repeated Tag
        - status: PetStatus

      ### Order
        - id: int64
        - pet_id: int64
        - quantity: int32
        - ship_date: string
        - status: OrderStatus
        - complete: bool

      ### User
        - id: int64
        - username: string
        - first_name: string
        - last_name: string
        - email: string
        - password: string
        - phone: string
        - user_status: int32

      ### GetPetRequest
        - id: int64

      ### ListPetsRequest
        - status: repeated PetStatus
        - tags: repeated string
        - limit: int32
        - offset: int32

      ### ListPetsResponse
        - pets: repeated Pet
        - total: int32

      ### CreatePetRequest
        - name: string
        - category: Category
        - photo_urls: repeated string
        - tags: repeated Tag
        - status: PetStatus

      ### UpdatePetRequest
        - id: int64
        - name: string
        - category: Category
        - photo_urls: repeated string
        - tags: repeated Tag
        - status: PetStatus

      ### DeletePetRequest
        - id: int64

      ### DeletePetResponse
        - success: bool

      ### StreamPetUpdatesRequest
        - status_filter: repeated PetStatus

      ### PetUpdate
        - event_type: string
        - pet: Pet
        - timestamp: string

      ### GetInventoryResponse


      ### PlaceOrderRequest
        - pet_id: int64
        - quantity: int32
        - ship_date: string

      ### GetOrderRequest
        - id: int64

      ### DeleteOrderRequest
        - id: int64

      ### DeleteOrderResponse
        - success: bool

      ### CreateUserRequest
        - username: string
        - first_name: string
        - last_name: string
        - email: string
        - password: string
        - phone: string

      ### GetUserRequest
        - username: string

      ### UpdateUserRequest
        - username: string
        - first_name: string
        - last_name: string
        - email: string
        - password: string
        - phone: string

      ### DeleteUserRequest
        - username: string

      ### DeleteUserResponse
        - success: bool

      ### LoginRequest
        - username: string
        - password: string

      ### LoginResponse
        - token: string
        - expires_at: string

      ### LogoutRequest
        - token: string

      ### LogoutResponse
        - success: bool
    tags: []
    configuration: {}
    environments:
      - id: 059bfc38-001e-4000-8000-059bfc38059b
        name: Default
        variables:
          - key: baseUrl
            value: localhost:9000
    items:
      - id: 6863d264-0024-4000-8000-6863d2646863
        name: PetService
        documentation: Pet service for managing pets in the store
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            id: 08503bf9-002d-4000-8000-08503bf90850
            name: GetPet
            documentation: Get a single pet by ID
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: GetPet
            callType: unary
            requestMessage: |-
              {
                "id": 0
              }
            metadata: []
          - type: grpc
            id: 59f59470-002f-4000-8000-59f5947059f5
            name: ListPets
            documentation: List all pets with optional filtering
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: ListPets
            callType: unary
            requestMessage: |-
              {
                "status": [
                  {}
                ],
                "tags": [
                  ""
                ],
                "limit": 0,
                "offset": 0
              }
            metadata: []
          - type: grpc
            id: 7742d85b-0030-4000-8000-7742d85b7742
            name: CreatePet
            documentation: Create a new pet
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: CreatePet
            callType: unary
            requestMessage: |-
              {
                "name": "",
                "category": {},
                "photo_urls": [
                  ""
                ],
                "tags": [
                  {}
                ],
                "status": {}
              }
            metadata: []
          - type: grpc
            id: 0f1b9f48-0030-4000-8000-0f1b9f480f1b
            name: UpdatePet
            documentation: Update an existing pet
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: UpdatePet
            callType: unary
            requestMessage: |-
              {
                "id": 0,
                "name": "",
                "category": {},
                "photo_urls": [
                  ""
                ],
                "tags": [
                  {}
                ],
                "status": {}
              }
            metadata: []
          - type: grpc
            id: 4fb15096-0030-4000-8000-4fb150964fb1
            name: DeletePet
            documentation: Delete a pet
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: DeletePet
            callType: unary
            requestMessage: |-
              {
                "id": 0
              }
            metadata: []
          - type: grpc
            id: 43f4b6e9-0037-4000-8000-43f4b6e943f4
            name: StreamPetUpdates
            documentation: Stream pet updates in real-time
            tags:
              - server-stream
            url: '{{baseUrl}}'
            service: petstore.PetService
            method: StreamPetUpdates
            callType: server-stream
            requestMessage: |-
              {
                "status_filter": [
                  {}
                ]
              }
            metadata: []
      - id: 63bf21e6-0026-4000-8000-63bf21e663bf
        name: StoreService
        documentation: Store service for managing orders
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            id: 0c832d7a-0035-4000-8000-0c832d7a0c83
            name: GetInventory
            documentation: Get store inventory
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.StoreService
            method: GetInventory
            callType: unary
            requestMessage: '{}'
            metadata: []
          - type: grpc
            id: 074cf599-0033-4000-8000-074cf599074c
            name: PlaceOrder
            documentation: Place an order
            tags:
              - unary
            url: '{{baseUrl}}'
