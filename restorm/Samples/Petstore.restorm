  - folderType: environment
    id: 4ee2c28a-001c-4000-8000-4ee2c28a4ee2
    name: gRPC Docker
    documentation: |-
      # gRPC Docker

      gRPC API

      ## Messages

      ### HelloRequest
        - greeting: string

      ### HelloResponse
        - reply: string

      ### HeadersResponse


      ### IndexResponse
        - services: repeated string

      ### DummyMessage
        - f_string: string
        - f_strings: repeated string
        - f_int32: int32
        - f_int32s: repeated int32

      ### SubMessage
        - f_string: string

      ### SpecificErrorRequest
        - code: int32

      ### AddrResponse
        - addr: string
    tags: []
    configuration: {}
    environments:
      - id: 3f69cc0a-001c-4000-8000-3f69cc0a3f69
        name: Default
        variables:
          - key: baseUrl
            value: localhost:9000
    items:
      - id: 66ef834b-0024-4000-8000-66ef834b66ef
        name: HelloService
        documentation: Hello service - simple greeting
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            id: 6d144335-002e-4000-8000-6d1443356d14
            name: SayHello
            documentation: Say hello
            tags:
              - unary
            url: localhost:9000
            service: grpcbin.HelloService
            method: SayHello
            callType: unary
            requestMessage: |-
              {
                "greeting": ""
              }
            metadata: []
      - id: 00b3a817-0026-4000-8000-00b3a81700b3
        name: HeadersService
        documentation: Headers service - echo headers
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            id: 6af65cae-0032-4000-8000-6af65cae6af6
            name: GetHeaders
            documentation: Returns request headers
            tags:
              - unary
            url: localhost:9000
            service: grpcbin.HeadersService
            method: GetHeaders
            callType: unary
            requestMessage: '{}'
            metadata: []
      - id: 5e948cb5-0024-4000-8000-5e948cb55e94
        name: IndexService
        documentation: Index service - list available services
        tags:
          - service
        configuration: {}
