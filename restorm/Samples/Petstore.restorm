            method: PlaceOrder
            callType: unary
            requestMessage: |-
              {
                "pet_id": 0,
                "quantity": 0,
                "ship_date": ""
              }
            metadata: []
          - type: grpc
            id: 0d0d6578-0031-4000-8000-0d0d65780d0d
            name: GetOrder
            documentation: Get an order by ID
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.StoreService
            method: GetOrder
            callType: unary
            requestMessage: |-
              {
                "id": 0
              }
            metadata: []
          - type: grpc
            id: 1f37df7d-0034-4000-8000-1f37df7d1f37
            name: DeleteOrder
            documentation: Delete an order
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.StoreService
            method: DeleteOrder
            callType: unary
            requestMessage: |-
              {
                "id": 0
              }
            metadata: []
      - id: 49ea67dc-0025-4000-8000-49ea67dc49ea
        name: UserService
        documentation: User service for managing users
        tags:
          - service
        configuration: {}
        items:
          - type: grpc
            id: 0b4ba5bd-0032-4000-8000-0b4ba5bd0b4b
            name: CreateUser
            documentation: Create a new user
            tags:
              - unary
            url: '{{baseUrl}}'
            service: petstore.UserService
