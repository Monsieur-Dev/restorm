<details open>
<summary><strong>Node.js - @stomp/stompjs</strong></summary>

```javascript
import { Client } from '@stomp/stompjs';
import WebSocket from 'ws';

const client = new Client({
  brokerURL: '{{url}}',
  webSocketFactory: () => new WebSocket('{{url}}'),
  stompVersions: ['{{stompVersion}}'],
{{#if connectHeaders}}
  connectHeaders: {
{{#each connectHeaders}}    '{{key}}': '{{value}}'{{#unless @last}},{{/unless}}
{{/each}}  },
{{/if}}
  onConnect: () => {
    console.log('Connected');
{{#each subscriptions}}
    client.subscribe('{{destination}}', (message) => {
      console.log('Received on {{destination}}:', message.body);
{{#if needsAck}}
      message.ack();
{{/if}}
    }, { id: '{{id}}', ack: '{{ackMode}}' });
{{/each}}
{{#if sendDestination}}
    client.publish({
      destination: '{{sendDestination}}',
      body: JSON.stringify({{sendBody}}){{#if sendHeaders}},
      headers: {
{{#each sendHeaders}}        '{{key}}': '{{value}}'{{#unless @last}},{{/unless}}
{{/each}}      }{{/if}}
    });
{{/if}}
  },
  onStompError: (frame) => {
    console.error('Broker error:', frame.headers['message'], frame.body);
  },
  onWebSocketError: (event) => {
    console.error('WebSocket error:', event);
  }
});

client.activate();

// To disconnect:
// client.deactivate();
```

