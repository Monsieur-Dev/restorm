```javascript
const soapBody = `{{body}}`;

fetch('{{url}}', {
  method: 'POST',
  headers: {
    'Content-Type': 'text/xml; charset=utf-8',
    'SOAPAction': '{{soapAction}}'{{#if headers}},
{{#each headers}}    '{{key}}': '{{value}}'{{#unless @last}},{{/unless}}
{{/each}}{{/if}}
  },
  body: soapBody
})
  .then(response => response.text())
  .then(xml => {
    const parser = new DOMParser();
    const doc = parser.parseFromString(xml, 'text/xml');
    console.log(doc);
