<details>
<summary><strong>Go - google.golang.org/grpc</strong></summary>

```go
package main

import (
    "context"
    "log"
{{#unless plaintext}}    "google.golang.org/grpc/credentials"{{/unless}}
    "google.golang.org/grpc"
{{#if metadata}}    "google.golang.org/grpc/metadata"{{/if}}
    pb "your/package/path/{{package}}"
)

func main() {
{{#if plaintext}}
    conn, err := grpc.Dial("{{host}}", grpc.WithInsecure())
{{else}}
    creds, err := credentials.NewClientTLSFromFile("cert.pem", "")
    if err != nil {
        log.Fatalf("Failed to load credentials: %v", err)
    }
    conn, err := grpc.Dial("{{host}}", grpc.WithTransportCredentials(creds))
{{/if}}
    if err != nil {
        log.Fatalf("Failed to connect: %v", err)
    }
    defer conn.Close()

    client := pb.New{{serviceName}}Client(conn)

    ctx := context.Background()
{{#if metadata}}
    md := metadata.Pairs(
{{#each metadata}}        "{{key}}", "{{value}}",
{{/each}}    )
    ctx = metadata.NewOutgoingContext(ctx, md)
{{/if}}

    request := &pb.{{requestType}}{{requestMessage}}

{{#if isUnary}}
    response, err := client.{{method}}(ctx, request)
    if err != nil {
        log.Fatalf("Error: %v", err)
    }
    log.Printf("Response: %v", response)
{{/if}}
{{#if isServerStream}}
    stream, err := client.{{method}}(ctx, request)
    if err != nil {
        log.Fatalf("Error: %v", err)
    }
    for {
        response, err := stream.Recv()
        if err != nil {
            break
        }
        log.Printf("Response: %v", response)
    }
{{/if}}
{{#if isClientStream}}
    stream, err := client.{{method}}(ctx)
    if err != nil {
        log.Fatalf("Error: %v", err)
    }
    stream.Send(request)
    response, err := stream.CloseAndRecv()
    if err != nil {
        log.Fatalf("Error: %v", err)
    }
    log.Printf("Response: %v", response)
{{/if}}
{{#if isBidirectional}}
    stream, err := client.{{method}}(ctx)
    if err != nil {
        log.Fatalf("Error: %v", err)
    }
    
    go func() {
        stream.Send(request)
        stream.CloseSend()
    }()
    
    for {
        response, err := stream.Recv()
        if err != nil {
            break
        }
        log.Printf("Response: %v", response)
    }
{{/if}}
}
```

