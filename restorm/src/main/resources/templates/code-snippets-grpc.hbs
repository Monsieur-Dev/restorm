<summary><strong>JavaScript - @grpc/grpc-js</strong></summary>

```javascript
const grpc = require('@grpc/grpc-js');
const protoLoader = require('@grpc/proto-loader');

const packageDefinition = protoLoader.loadSync('{{protoFile}}', {
  keepCase: true,
  longs: String,
  enums: String,
  defaults: true,
  oneofs: true
});

const proto = grpc.loadPackageDefinition(packageDefinition).{{package}};
const client = new proto.{{serviceName}}(
  '{{host}}',
  {{#if plaintext}}grpc.credentials.createInsecure(){{else}}grpc.credentials.createSsl(){{/if}}
);

{{#if metadata}}
const metadata = new grpc.Metadata();
{{#each metadata}}
metadata.add('{{key}}', '{{value}}');
{{/each}}

{{/if}}
const request = {{requestMessage}};

{{#if isUnary}}
client.{{methodName}}(request{{#if metadata}}, metadata{{/if}}, (error, response) => {
  if (error) {
    console.error('Error:', error);
    return;
  }
  console.log('Response:', response);
});
{{/if}}
{{#if isServerStream}}
const call = client.{{methodName}}(request{{#if metadata}}, metadata{{/if}});
call.on('data', (response) => {
  console.log('Response:', response);
});
call.on('error', (error) => {
  console.error('Error:', error);
});
call.on('end', () => {
  console.log('Stream ended');
});
{{/if}}
{{#if isClientStream}}
const call = client.{{methodName}}({{#if metadata}}metadata, {{/if}}(error, response) => {
  if (error) {
    console.error('Error:', error);
    return;
  }
  console.log('Response:', response);
});
call.write(request);
call.end();
{{/if}}
{{#if isBidirectional}}
const call = client.{{methodName}}({{#if metadata}}metadata{{/if}});
call.on('data', (response) => {
  console.log('Response:', response);
});
call.on('error', (error) => {
  console.error('Error:', error);
});
call.on('end', () => {
  console.log('Stream ended');
});
call.write(request);
call.end();
{{/if}}
```

