<summary><strong>Java - grpc-java</strong></summary>

```java
import io.grpc.ManagedChannel;
import io.grpc.ManagedChannelBuilder;
{{#if metadata}}import io.grpc.Metadata;
import io.grpc.stub.MetadataUtils;{{/if}}
import {{package}}.{{serviceName}}Grpc;
import {{package}}.{{requestType}};

public class GrpcExample {
    public static void main(String[] args) {
        ManagedChannel channel = ManagedChannelBuilder
            .forTarget("{{host}}")
{{#if plaintext}}            .usePlaintext(){{/if}}
            .build();

{{#if metadata}}
        Metadata metadata = new Metadata();
{{#each metadata}}
        metadata.put(Metadata.Key.of("{{key}}", Metadata.ASCII_STRING_MARSHALLER), "{{value}}");
{{/each}}
{{/if}}

        {{serviceName}}Grpc.{{serviceName}}BlockingStub stub = {{serviceName}}Grpc.newBlockingStub(channel){{#if metadata}}
            .withInterceptors(MetadataUtils.newAttachHeadersInterceptor(metadata)){{/if}};

        {{requestType}} request = {{requestType}}.newBuilder()
            // .setField(value)
            .build();

{{#if isUnary}}
        var response = stub.{{methodName}}(request);
        System.out.println("Response: " + response);
{{/if}}
{{#if isServerStream}}
        var responses = stub.{{methodName}}(request);
        responses.forEachRemaining(response -> {
            System.out.println("Response: " + response);
        });
{{/if}}

        channel.shutdown();
    }
}
