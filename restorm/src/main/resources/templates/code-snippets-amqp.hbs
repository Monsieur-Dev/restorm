{{#if isPublish}}
<details open>
<summary><strong>JavaScript - amqplib (Node.js)</strong></summary>

```javascript
const amqp = require('amqplib');

async function main() {
  const connection = await amqp.connect('{{url}}');
  const channel = await connection.createChannel();

  channel.publish('{{exchange}}', '{{routingKey}}', Buffer.from(JSON.stringify({{payload}})));
  console.log('Published to exchange "{{exchange}}" with routing key "{{routingKey}}"');

  await channel.close();
  await connection.close();
}

main().catch(console.error);
```

</details>

<details>
<summary><strong>Python - pika</strong></summary>

```python
import pika
import json

connection = pika.BlockingConnection(pika.URLParameters('{{url}}'))
channel = connection.channel()

payload = json.dumps({{payload}})
channel.basic_publish(exchange='{{exchange}}', routing_key='{{routingKey}}', body=payload)
print(f'Published to exchange "{{exchange}}" with routing key "{{routingKey}}"')

connection.close()
```

</details>

<details>
<summary><strong>Shell - amqp-publish (amqp-tools)</strong></summary>

```bash
amqp-publish --url='{{url}}' \
  --exchange='{{exchange}}' \
  --routing-key='{{routingKey}}' \
  --body='{{payload}}'
```

