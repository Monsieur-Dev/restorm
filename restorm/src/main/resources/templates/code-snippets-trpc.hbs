<details>
<summary><strong>Go</strong></summary>

```go
package main

import (
    "fmt"
    "io"
    "net/http"{{#if body}}
    "strings"{{/if}}
)

func main() {
    {{#if body}}body := strings.NewReader(`{{body}}`)
    req, err := http.NewRequest("{{method}}", "{{url}}", body){{else}}req, err := http.NewRequest("{{method}}", "{{url}}", nil){{/if}}
    if err != nil {
        panic(err)
    }
{{#if body}}    req.Header.Set("Content-Type", "application/json")
{{/if}}
{{#each headers}}    req.Header.Set("{{key}}", "{{value}}")
{{/each}}
    client := &http.Client{}
    resp, err := client.Do(req)
    if err != nil {
        panic(err)
    }
    defer resp.Body.Close()

    respBody, _ := io.ReadAll(resp.Body)
    // Non-batch tRPC responses are `[{ result: { data } }]` — unwrap it.
    fmt.Println(string(respBody))
}
```

</details>
