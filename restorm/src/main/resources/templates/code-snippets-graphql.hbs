<details>
<summary><strong>Ruby - graphql-client</strong></summary>

```ruby
require 'graphql/client'
require 'graphql/client/http'

HTTP = GraphQL::Client::HTTP.new("{{url}}") do
  def headers(context)
    {
      "Content-Type" => "application/json"{{#if headers}},
{{#each headers}}      "{{key}}" => "{{value}}"{{#unless @last}},{{/unless}}
{{/each}}{{/if}}
    }
  end
end

Schema = GraphQL::Client.load_schema(HTTP)
Client = GraphQL::Client.new(schema: Schema, execute: HTTP)

Query = Client.parse <<-'GRAPHQL'
{{query}}
GRAPHQL

result = Client.query(Query, variables: {{variables}})
puts result.data.to_h
```

