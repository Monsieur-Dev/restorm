<details>
<summary><strong>TypeScript - Fetch</strong></summary>

```typescript
interface GraphQLResponse<T> {
  data?: T;
  errors?: Array<{ message: string }>;
}

const query = `{{query}}`;

async function executeGraphQL<T>(): Promise<GraphQLResponse<T>> {
  const response = await fetch('{{url}}', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'{{#if headers}},
{{#each headers}}      '{{key}}': '{{value}}'{{#unless @last}},{{/unless}}
{{/each}}{{/if}}
    },
    body: JSON.stringify({
      query,
      variables: {{variables}}
    })
  });

  if (!response.ok) {
    throw new Error(`HTTP error! status: ${response.status}`);
  }

  return response.json();
}

executeGraphQL().then(console.log).catch(console.error);
```

