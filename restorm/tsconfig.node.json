{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "electron-core-ui/main": ["../electron-core-ui/src/main/index.ts"],
      "electron-core-ui/types": ["../electron-core-ui/types/index.ts"]
    }
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "../electron-core-ui/src/main/**/*",
    "../electron-core-ui/src/preload/**/*",
    // ECUI's process-agnostic layer, reached from its main barrel (auth state,
    // privacy/consent model, the payload scrubber). A `composite` project must
    // list every file it pulls in, so importing one of these transitively from
    // `electron-core-ui/main` fails with TS6307 unless the tree is included.
    "../electron-core-ui/src/shared/**/*",
    "../electron-core-ui/types/**/*"
  ]
}
