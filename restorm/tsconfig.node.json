{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "electron-core-ui/main": ["../electron-core-ui/src/main/index.ts"],
      "electron-core-ui/types": ["../electron-core-ui/types/index.ts"]
    }
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "../electron-core-ui/src/main/**/*",
    "../electron-core-ui/src/preload/**/*",
    "../electron-core-ui/types/**/*"
  ]
}
