{
  "name": "restorm",
  "version": "0.1.12-preview",
  "description": "restorm - A REST API client",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/oYo-fr/restorm",
  "author": {
    "name": "Yoann Diguet",
    "email": "contact@oyo-fr.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "dev:petstore": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -- --open tests/e2e/samples/Petstore.restorm",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "test:complete": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:ci": "pnpm run docker:up && pnpm run docker:wait && pnpm run test:all && pnpm run docker:down",
    "test:e2e": "bddgen && node scripts/run-e2e.mjs",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "coverage:clean": "node scripts/coverage/clean.js",
    "coverage:unit": "vitest run --config vitest.config.ts --coverage",
    "coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "coverage:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=8192 VITE_COVERAGE=true E2E_COVERAGE=true pnpm run build && cross-env VITE_COVERAGE=true E2E_COVERAGE=true pnpm run test:e2e && pnpm run coverage:e2e:report",
    "coverage:e2e:report": "nyc report --reporter=lcov --report-dir coverage/e2e-renderer --temp-directory .nyc_output && c8 report --reporter=lcov --report-dir coverage/e2e-node --temp-directory .v8-coverage",
    "coverage:merge": "lcov-result-merger \"coverage/**/lcov.info\" \"coverage/lcov.info\" --prepend-source-files",
    "coverage": "pnpm run coverage:clean && pnpm run coverage:unit && pnpm run coverage:integration && pnpm run coverage:e2e && pnpm run coverage:merge",
    "docker:up": "docker compose -f tests/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f tests/docker/docker-compose.yml down",
    "docker:wait": "node tests/integration/wait-for-services.js",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@milkdown/crepe": "^7.21.1",
    "@milkdown/kit": "^7.21.1",
    "@milkdown/react": "^7.21.1",
    "@monaco-editor/react": "^4.7.0",
    "@vscode/codicons": "^0.0.45",
    "@xyflow/react": "^12.10.2",
    "@zip.js/zip.js": "^2.8.26",
    "axios": "^1.16.1",
    "electron-core-ui": "workspace:*",
    "lottie-react": "^2.4.1",
    "elkjs": "^0.11.1",
    "handlebars": "^4.7.9",
    "i18next": "^26.2.0",
    "luxon": "^3.7.2",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "ws": "^8.20.1",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "~8.58.1",
    "@typescript-eslint/parser": "~8.58.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "c8": "^11.0.0",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^29.1.1",
    "lcov-result-merger": "^6.0.0",
    "minisearch": "^7.2.0",
    "nyc": "^18.0.0",
    "playwright": "^1.60.0",
    "playwright-bdd": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "~8.58.1",
    "vite": "^7.3.2",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "com.oyo-fr.restorm",
    "productName": "restorm",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "Yoann Diguet <contact@oyo-fr.com>",
      "executableName": "restorm-bin"
    },
    "deb": {
      "afterInstall": "build/postinstall.sh"
    },
    "rpm": {
      "afterInstall": "build/postinstall.sh"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
