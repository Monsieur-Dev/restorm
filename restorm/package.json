{
  "name": "restorm",
  "version": "1.2.2-preview",
  "description": "Local-first API designer and testing environment — client and server",
  "main": "dist/main/index.js",
  "homepage": "https://restorm.app",
  "author": {
    "name": "MonsieurDev",
    "email": "contact@restorm.app"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate-icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs && node scripts/generate-sandbox-prelude.mts",
    "predist": "node scripts/generate-icons.mjs && node scripts/generate-sandbox-prelude.mts",
    "prepackage": "node scripts/generate-icons.mjs && node scripts/generate-sandbox-prelude.mts",
    "generate:brand-font": "node scripts/generate-brand-font.mjs",
    "generate:wordmark-font": "node scripts/generate-wordmark-font.mjs",
    "dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "dev:petstore": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -- --open tests/e2e/samples/Petstore.restorm",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "predist:store": "node scripts/generate-icons.mjs && node scripts/generate-sandbox-prelude.mts",
    "dist:store": "electron-vite build && electron-builder --win appx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "test:complete": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:ci": "pnpm run docker:up && pnpm run docker:wait && pnpm run test:all && pnpm run docker:down",
    "test:e2e": "bddgen && node scripts/run-e2e.mjs",
    "headless": "node scripts/headless-run.mjs",
    "headless:main": "node scripts/headless-run.mjs \"Auth Service/Pet API/Main\"",
    "test:e2e:real-deps": "cross-env RESTORM_E2E_REAL_DEPS=1 bddgen && cross-env RESTORM_E2E_REAL_DEPS=1 xvfb-run -a playwright test --project code-deps-real-registry",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "coverage:clean": "node scripts/coverage/clean.js",
    "coverage:unit": "vitest run --config vitest.config.ts --coverage",
    "coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "coverage:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=8192 VITE_COVERAGE=true E2E_COVERAGE=true pnpm run build && cross-env VITE_COVERAGE=true E2E_COVERAGE=true pnpm run test:e2e && pnpm run coverage:e2e:report",
    "coverage:e2e:report": "nyc report --reporter=lcov --report-dir coverage/e2e-renderer --temp-directory .nyc_output && c8 report --reporter=lcov --report-dir coverage/e2e-node --temp-directory .v8-coverage",
    "coverage:merge": "lcov-result-merger \"coverage/**/lcov.info\" \"coverage/lcov.info\" --prepend-source-files",
    "coverage": "pnpm run coverage:clean && pnpm run coverage:unit && pnpm run coverage:integration && pnpm run coverage:e2e && pnpm run coverage:merge",
    "docker:up": "docker compose -f tests/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f tests/docker/docker-compose.yml down",
    "docker:wait": "node tests/integration/wait-for-services.js",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@creditkarma/thrift-parser": "^2.0.0",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@grpc/reflection": "^1.0.4",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@ruby/3.4-wasm-wasi": "2.10.1",
    "@ruby/wasm-wasi": "2.10.1",
    "@sentry/electron": "^7.20.2",
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi": "^1.17.0",
    "@typespec/openapi3": "^1.17.0",
    "@vscode/codicons": "0.0.46-24",
    "@xyflow/react": "^12.12.1",
    "@zip.js/zip.js": "^2.24.0",
    "aedes": "1.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqplib": "^2.2.1",
    "axios": "^1.21.0",
    "chai": "^4.5.0",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "cron-parser": "^5.10.3",
    "crypto-js": "^4.2.0",
    "dbus-next": "^0.10.2",
    "drafter.js": "^3.2.0",
    "electron-core-ui": "workspace:*",
    "electron-updater": "^6.8.11",
    "elkjs": "^0.12.1",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.12.0",
    "graphql-sse": "^2.6.3",
    "handlebars": "^4.7.10",
    "i18next": "^26.7.1",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "lodash": "^4.18.1",
    "lottie-react": "^2.4.2",
    "luxon": "^3.7.2",
    "moment": "^2.31.0",
    "monaco-editor": "^0.56.0",
    "mqtt": "^5.16.1",
    "nanoid": "^6.0.2",
    "pyodide": "^314.0.7",
    "quickjs-emscripten": "^0.32.0",
    "raml-1-parser": "1.1.67",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tar": "^7.5.22",
    "tough-cookie": "^6.0.2",
    "undici": "^8.12.3",
    "uuid": "^14.0.3",
    "wasmoon": "^1.16.0",
    "webr": "^0.6.0",
    "ws": "^8.22.1",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "5.4.0",
    "@testcontainers/kafka": "^12.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/crypto-js": "^4.2.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-istanbul": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "electron": "^43.8.7",
    "electron-builder": "26.15.3",
    "dmg-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "fantasticon": "4.1.0",
    "globals": "^17.14.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3",
    "lcov-result-merger": "^6.0.0",
    "minisearch": "^7.2.0",
    "nyc": "^18.0.0",
    "playwright": "^1.64.1",
    "playwright-bdd": "^9.2.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.58.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.monsieurdev.restorm",
    "productName": "Restorm",
    "fileAssociations": [
      {
        "ext": "restorm",
        "name": "Restorm project",
        "description": "Restorm API project",
        "mimeType": "application/x-restorm",
        "role": "Editor",
        "rank": "Owner",
        "icon": "assets/icons/icon"
      }
    ],
    "protocols": [
      {
        "name": "Restorm",
        "schemes": [
          "restorm",
          "restorm-preview"
        ]
      }
    ],
    "beforePack": "scripts/before-pack.cjs",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "node_modules/**/*",
      "package.json",
      "assets/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources/dotnet-wasm",
        "to": "restorm-resources/dotnet-wasm"
      },
      {
        "from": "resources/settings.yaml",
        "to": "restorm-resources/settings.yaml"
      },
      {
        "from": "resources/sandbox-stdlib-prelude.js",
        "to": "restorm-resources/sandbox-stdlib-prelude.js"
      },
      {
        "from": "resources/features.yaml",
        "to": "restorm-resources/features.yaml"
      },
      {
        "from": "../electron-core-ui/resources",
        "to": "resources"
      },
      {
        "from": "CHANGELOG.md",
        "to": "restorm-resources/CHANGELOG.md"
      },
      {
        "from": "changelogs",
        "to": "restorm-resources/changelogs"
      },
      {
        "from": "build/com.monsieurdev.restorm.metainfo.xml",
        "to": "restorm-resources/com.monsieurdev.restorm.metainfo.xml"
      },
      {
        "from": "../scripts/mcp-launcher.mjs",
        "to": "restorm-resources/mcp-launcher.mjs"
      }
    ],
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "summary": "Local-first API testing environment — client and server",
      "plugs": [
        "default",
        "password-manager-service"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "snap"
      ],
      "icon": "assets/icons/linux",
      "category": "Development",
      "maintainer": "MonsieurDev <contact@restorm.app>",
      "vendor": "MonsieurDev",
      "synopsis": "Local-first API designer and testing environment — client and server",
      "description": "Restorm is a local-first environment to design and test APIs end to end: it is both an API client and a server. Design an API and generate its docs, send and inspect requests, mock and simulate endpoints, and chain reproducible scenarios across REST, GraphQL, gRPC, WebSocket, Redis, AMQP, MQTT and more — everything kept on your own disk, Git-friendly for teams, with no forced cloud account.",
      "executableName": "restorm-bin",
      "desktop": {
        "entry": {
          "Name": "Restorm",
          "GenericName": "API Testing Environment",
          "Comment": "Local-first API testing environment — client and server",
          "Categories": "Development;Network;WebDevelopment;",
          "Keywords": "REST;API;HTTP;GraphQL;gRPC;WebSocket;",
          "StartupWMClass": "restorm",
          "MimeType": "application/x-restorm;",
          "Actions": "new;"
        },
        "desktopActions": {
          "new": {
            "Name": "New",
            "Name[cs]": "Nový",
            "Name[da]": "Ny",
            "Name[de]": "Neu",
            "Name[el]": "Νέο",
            "Name[es]": "Nuevo",
            "Name[fi]": "Uusi",
            "Name[fr]": "Nouveau",
            "Name[hr]": "Novo",
            "Name[hu]": "Új",
            "Name[id]": "Baru",
            "Name[it]": "Nuovo",
            "Name[ja]": "新規作成",
            "Name[ko]": "새로 만들기",
            "Name[nb]": "Ny",
            "Name[nl]": "Nieuw",
            "Name[pl]": "Nowy",
            "Name[pt]": "Novo",
            "Name[ro]": "Nou",
            "Name[sq]": "I ri",
            "Name[sr]": "Novo",
            "Name[sv]": "Ny",
            "Name[tr]": "Yeni",
            "Name[uk]": "Створити",
            "Name[vi]": "Mới",
            "Name[zh_CN]": "新建",
            "Name[zh_TW]": "新增",
            "Icon": "document-new",
            "Exec": "AppRun --no-sandbox --new"
          }
        }
      }
    },
    "deb": {
      "afterInstall": "build/postinstall.sh",
      "afterRemove": "build/postremove.sh"
    },
    "rpm": {
      "afterInstall": "build/postinstall.sh",
      "afterRemove": "build/postremove.sh"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "appx": {
      "identityName": "MonsieurDev.Restorm",
      "publisher": "CN=9A3801C6-3716-4D88-B557-D4C59BA5C2F9",
      "publisherDisplayName": "MonsieurDev",
      "applicationId": "Restorm",
      "backgroundColor": "#1b1b1b",
      "showNameOnTiles": true,
      "languages": [
        "en-US",
        "fr-FR"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://dl.restorm.app",
        "useMultipleRangeRequest": false
      }
    ]
  }
}
