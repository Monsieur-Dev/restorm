{
  "name": "restorm",
  "version": "0.1.16",
  "description": "Local-first API testing environment — client and server",
  "main": "dist/main/index.js",
  "homepage": "https://restorm.app",
  "author": {
    "name": "MonsieurDev",
    "email": "contact@restorm.app"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate-icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs",
    "predist": "node scripts/generate-icons.mjs",
    "prepackage": "node scripts/generate-icons.mjs",
    "generate:brand-font": "node scripts/generate-brand-font.mjs",
    "generate:wordmark-font": "node scripts/generate-wordmark-font.mjs",
    "dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "dev:petstore": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -- --open tests/e2e/samples/Petstore.restorm",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "test:complete": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:ci": "pnpm run docker:up && pnpm run docker:wait && pnpm run test:all && pnpm run docker:down",
    "test:e2e": "bddgen && node scripts/run-e2e.mjs",
    "headless": "node scripts/headless-run.mjs",
    "headless:main": "node scripts/headless-run.mjs \"Auth Service/Pet API/Main\"",
    "test:e2e:real-deps": "cross-env RESTORM_E2E_REAL_DEPS=1 bddgen && cross-env RESTORM_E2E_REAL_DEPS=1 xvfb-run -a playwright test --project code-deps-real-registry",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "coverage:clean": "node scripts/coverage/clean.js",
    "coverage:unit": "vitest run --config vitest.config.ts --coverage",
    "coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "coverage:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=8192 VITE_COVERAGE=true E2E_COVERAGE=true pnpm run build && cross-env VITE_COVERAGE=true E2E_COVERAGE=true pnpm run test:e2e && pnpm run coverage:e2e:report",
    "coverage:e2e:report": "nyc report --reporter=lcov --report-dir coverage/e2e-renderer --temp-directory .nyc_output && c8 report --reporter=lcov --report-dir coverage/e2e-node --temp-directory .v8-coverage",
    "coverage:merge": "lcov-result-merger \"coverage/**/lcov.info\" \"coverage/lcov.info\" --prepend-source-files",
    "coverage": "pnpm run coverage:clean && pnpm run coverage:unit && pnpm run coverage:integration && pnpm run coverage:e2e && pnpm run coverage:merge",
    "docker:up": "docker compose -f tests/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f tests/docker/docker-compose.yml down",
    "docker:wait": "node tests/integration/wait-for-services.js",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@creditkarma/thrift-parser": "^2.0.0",
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@grpc/reflection": "^1.0.4",
    "@milkdown/crepe": "^7.21.1",
    "@milkdown/kit": "^7.21.1",
    "@milkdown/react": "^7.21.1",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@ruby/3.4-wasm-wasi": "2.9.3-2.9.4",
    "@ruby/wasm-wasi": "2.9.3-2.9.4",
    "@typespec/compiler": "^1.13.0",
    "@typespec/http": "^1.13.0",
    "@typespec/openapi": "^1.13.0",
    "@typespec/openapi3": "^1.13.0",
    "@vscode/codicons": "^0.0.45",
    "@xyflow/react": "^12.10.2",
    "@zip.js/zip.js": "^2.8.26",
    "aedes": "1.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqplib": "^2.0.1",
    "axios": "^1.16.1",
    "chai": "^4.5.0",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.5.0",
    "crypto-js": "^4.2.0",
    "drafter.js": "^3.2.0",
    "electron-core-ui": "workspace:*",
    "electron-updater": "^6.8.9",
    "elkjs": "^0.11.1",
    "esbuild": "^0.28.0",
    "fast-xml-parser": "^4.5.6",
    "graphql-sse": "^2.6.0",
    "handlebars": "^4.7.9",
    "i18next": "^26.2.0",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "lodash": "^4.18.1",
    "lottie-react": "^2.4.1",
    "luxon": "^3.7.2",
    "moment": "^2.30.1",
    "monaco-editor": "^0.55.1",
    "mqtt": "^5.15.1",
    "nanoid": "^5.1.11",
    "pyodide": "^0.29.4",
    "quickjs-emscripten": "^0.32.0",
    "raml-1-parser": "1.1.67",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "tar": "^7.5.19",
    "undici": "^8.7.0",
    "uuid": "^14.0.0",
    "wasmoon": "^1.16.0",
    "webr": "^0.6.0",
    "ws": "^8.20.1",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "~8.58.1",
    "@typescript-eslint/parser": "~8.58.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "c8": "^11.0.0",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fantasticon": "4.1.0",
    "globals": "^17.6.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^29.1.1",
    "lcov-result-merger": "^6.0.0",
    "minisearch": "^7.2.0",
    "nyc": "^18.0.0",
    "playwright": "^1.60.0",
    "playwright-bdd": "^8.5.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "~8.58.1",
    "vite": "^7.3.2",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "com.monsieurdev.restorm",
    "productName": "restorm",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "assets/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources/dotnet-wasm",
        "to": "restorm-resources/dotnet-wasm"
      },
      {
        "from": "resources/settings.yaml",
        "to": "restorm-resources/settings.yaml"
      },
      {
        "from": "resources/features.yaml",
        "to": "restorm-resources/features.yaml"
      },
      {
        "from": "../electron-core-ui/resources",
        "to": "resources"
      },
      {
        "from": "CHANGELOG.md",
        "to": "restorm-resources/CHANGELOG.md"
      },
      {
        "from": "changelogs",
        "to": "restorm-resources/changelogs"
      },
      {
        "from": "build/com.monsieurdev.restorm.metainfo.xml",
        "to": "restorm-resources/com.monsieurdev.restorm.metainfo.xml"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/icons/linux",
      "category": "Development",
      "maintainer": "MonsieurDev <contact@restorm.app>",
      "vendor": "MonsieurDev",
      "synopsis": "Local-first API testing environment — client and server",
      "description": "Restorm is a local-first environment to test APIs end to end: it is both an API client and a server. Send and inspect requests, mock and simulate endpoints, and chain reproducible scenarios across REST, GraphQL, gRPC, WebSocket, Redis, AMQP, MQTT and more — everything kept on your own disk, Git-friendly for teams, with no forced cloud account.",
      "executableName": "restorm-bin",
      "desktop": {
        "entry": {
          "Name": "Restorm",
          "GenericName": "API Testing Environment",
          "Comment": "Local-first API testing environment — client and server",
          "Categories": "Development;Network;WebDevelopment;",
          "Keywords": "REST;API;HTTP;GraphQL;gRPC;WebSocket;",
          "StartupWMClass": "restorm"
        }
      }
    },
    "deb": {
      "afterInstall": "build/postinstall.sh",
      "afterRemove": "build/postremove.sh"
    },
    "rpm": {
      "afterInstall": "build/postinstall.sh",
      "afterRemove": "build/postremove.sh"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://dl.restorm.app"
      }
    ]
  }
}
