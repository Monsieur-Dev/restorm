{
  "name": "restorm",
  "version": "0.1.12-preview",
  "description": "restorm - A REST API client",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/oYo-fr/restorm",
  "author": {
    "name": "Yoann Diguet",
    "email": "contact@oyo-fr.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "dev:petstore": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -- --open tests/e2e/samples/Petstore.restorm",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "test:complete": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:ci": "pnpm run docker:up && pnpm run docker:wait && pnpm run test:all && pnpm run docker:down",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "coverage:clean": "node scripts/coverage/clean.js",
    "coverage:unit": "vitest run --config vitest.config.ts --coverage",
    "coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "coverage:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=8192 VITE_COVERAGE=true E2E_COVERAGE=true pnpm run build && cross-env VITE_COVERAGE=true E2E_COVERAGE=true pnpm run test:e2e && pnpm run coverage:e2e:report",
    "coverage:e2e:report": "nyc report --reporter=lcov --report-dir coverage/e2e-renderer --temp-directory .nyc_output && c8 report --reporter=lcov --report-dir coverage/e2e-node --temp-directory .v8-coverage",
    "coverage:merge": "lcov-result-merger \"coverage/**/lcov.info\" \"coverage/lcov.info\" --prepend-source-files",
    "coverage": "pnpm run coverage:clean && pnpm run coverage:unit && pnpm run coverage:integration && pnpm run coverage:e2e && pnpm run coverage:merge",
    "docker:up": "docker compose -f tests/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f tests/docker/docker-compose.yml down",
    "docker:wait": "node tests/integration/wait-for-services.js",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.17.3",
    "@milkdown/kit": "^7.17.3",
    "@milkdown/react": "^7.17.3",
    "@monaco-editor/react": "^4.7.0",
    "@vscode/codicons": "^0.0.44",
    "@zip.js/zip.js": "^2.8.15",
    "axios": "^1.13.2",
    "electron-core-ui": "workspace:*",
    "handlebars": "^4.7.8",
    "i18next": "^25.7.3",
    "jsoncrack-react": "^0.0.1-beta.4",
    "luxon": "^3.7.2",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.2",
    "yargs": "^17.7.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "c8": "^10.1.3",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^27.3.0",
    "lcov-result-merger": "^5.0.1",
    "minisearch": "^7.2.0",
    "nyc": "^17.1.0",
    "playwright": "^1.56.0",
    "playwright-bdd": "^8.4.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.oyo-fr.restorm",
    "productName": "restorm",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "Yoann Diguet <contact@oyo-fr.com>",
      "executableName": "restorm-bin"
    },
    "deb": {
      "afterInstall": "build/postinstall.sh"
    },
    "rpm": {
      "afterInstall": "build/postinstall.sh"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
