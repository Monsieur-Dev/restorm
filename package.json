{
  "name": "gitable-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Gitable monorepo with electron-vscodelike-core-ui",
  "homepage": "https://github.com/oYo-fr/gitable",
  "author": {
    "name": "Yoann Diguet",
    "email": "contact@oyo-fr.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "cd gitable && npx cross-env ELECTRON_DISABLE_SANDBOX=1 npx electron-vite dev",
    "build:core-ui": "cd electron-vscodelike-core-ui && npm run build",
    "build:gitable": "cd gitable && npm run build",
    "build": "npm run build:core-ui && cd gitable && npm install ../electron-vscodelike-core-ui && npm run build",
    "lint": "cd gitable && npm run lint"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
