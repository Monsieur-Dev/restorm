{
  "name": "restorm-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Restorm monorepo with electron-core-ui",
  "homepage": "https://github.com/oYo-fr/restorm",
  "author": {
    "name": "Yoann Diguet",
    "email": "contact@oyo-fr.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "npx rimraf node_modules electron-core-ui/node_modules electron-core-ui/dist demo/node_modules demo/dist demo/out demo/.vite restorm/node_modules restorm/dist restorm/out restorm/.vite",
    "rebuild:all": "pnpm run clean && pnpm install && pnpm run build",
    "dev:demo": "pnpm --filter demo run dev",
    "dev:restorm": "pnpm --filter restorm run dev",
    "dev:restorm:log": "pnpm run dev:restorm > restorm-dev.log 2>&1",
    "build:core-ui": "pnpm --filter electron-core-ui run build",
    "build:demo": "pnpm --filter demo run build",
    "build:restorm": "pnpm --filter restorm run build",
    "build": "pnpm run build:core-ui && pnpm run build:demo && pnpm run build:restorm",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "typecheck": "pnpm -r run typecheck",
    "depcheck": "pnpm -r run depcheck",
    "test": "pnpm --filter electron-core-ui run test && pnpm --filter restorm run test",
    "backup": "tar --exclude='node_modules' --exclude='*/node_modules/*' --exclude='bin' --exclude='*/bin/*' --exclude='out' --exclude='*/out/*' --exclude='dist' --exclude='*/dist/*' -czf ../restorm-backup-$(date +%Y%m%d-%H%M%S).tar.gz .",
    "restorm:docker:up": "pnpm --filter restorm run docker:up",
    "restorm:docker:down": "pnpm --filter restorm run docker:down"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.0.5",
      "react-dom": "^19.0.5"
    },
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
