{
  "name": "gitable-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Gitable monorepo with electron-core-ui",
  "homepage": "https://github.com/oYo-fr/gitable",
  "author": {
    "name": "Yoann Diguet",
    "email": "contact@oyo-fr.com"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "bash -c 'node node_modules/.pnpm/electron@*/node_modules/electron/install.js' || true",
    "clean": "npx rimraf node_modules electron-core-ui/node_modules electron-core-ui/dist gitable/node_modules gitable/dist gitable/out gitable/.vite demo/node_modules demo/dist demo/out demo/.vite restorm/node_modules restorm/dist restorm/out restorm/.vite",
    "rebuild:all": "pnpm run clean && pnpm install && pnpm run build",
    "dev:gitable": "pnpm --filter gitable run dev",
    "dev:demo": "pnpm --filter demo run dev",
    "dev:restorm": "pnpm --filter restorm run dev",
    "build:core-ui": "pnpm --filter electron-core-ui run build",
    "build:gitable": "pnpm --filter gitable run build",
    "build:demo": "pnpm --filter demo run build",
    "build:restorm": "pnpm --filter restorm run build",
    "build": "pnpm run build:core-ui && pnpm run build:gitable && pnpm run build:demo && pnpm run build:restorm",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "typecheck": "pnpm -r run typecheck",
    "depcheck": "pnpm -r run depcheck",
    "test": "pnpm --filter restorm run test",
    "backup": "tar --exclude='node_modules' --exclude='*/node_modules/*' --exclude='bin' --exclude='*/bin/*' --exclude='out' --exclude='*/out/*' --exclude='dist' --exclude='*/dist/*' -czf ../gitable-backup-$(date +%Y%m%d-%H%M%S).tar.gz .",
    "restorm:docker:up": "pnpm --filter restorm run docker:up",
    "restorm:docker:down": "pnpm --filter restorm run docker:down"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "rimraf": "^6.0.1"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.2.3",
      "react-dom": "^19.2.3"
    }
  }
}
