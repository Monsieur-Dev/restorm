#!/bin/sh

echo "🔍 Running pre-commit checks..."

# STRICT MODE: Block eslint-disable and skipped tests
echo "🚫 Checking for forbidden patterns..."

# Check for eslint-disable (actual directives, not just comments mentioning it)
# Look for: /* eslint-disable or // eslint-disable or /* eslint-disable-next-line or // eslint-disable-next-line
if git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -E '(^|[^a-zA-Z])(\/\/|\/\*)\s*eslint-disable' 2>/dev/null; then
    echo "❌ BLOCKED: eslint-disable directives are STRICTLY FORBIDDEN!"
    echo ""
    echo "Files with eslint-disable directives:"
    git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -n -E '(^|[^a-zA-Z])(\/\/|\/\*)\s*eslint-disable' 2>/dev/null
    echo ""
    echo "⛔ Project rule: Fix the underlying issues instead of suppressing warnings."
    exit 1
fi

# Check for skipped tests
if git diff --cached --name-only | grep -E '\.test\.(ts|tsx|js|jsx)$' | xargs grep -l -E "(\btest\.skip\b|\bit\.skip\b|\bdescribe\.skip\b|\bxtest\s*\(|\bxit\s*\(|\bxdescribe\s*\()" 2>/dev/null; then
    echo "❌ BLOCKED: Skipped tests detected!"
    echo ""
    echo "Files with skipped tests:"
    git diff --cached --name-only | grep -E '\.test\.(ts|tsx|js|jsx)$' | xargs grep -n -E "(\btest\.skip\b|\bit\.skip\b|\bdescribe\.skip\b|\bxtest\s*\(|\bxit\s*\(|\bxdescribe\s*\()" 2>/dev/null
    echo ""
    echo "⛔ Project rule: All tests must be enabled and passing."
    exit 1
fi

echo "✅ No forbidden patterns found"
echo ""

# i18n guard: missing-from-en keys + false-tick translations
echo "🌍 Running i18n guard..."
node scripts/check-i18n.mjs || exit 1
echo ""

# electron-core-ui
echo "📦 electron-core-ui: depcheck"
cd electron-core-ui && npx depcheck || exit 1
echo "📦 electron-core-ui: lint"
pnpm run lint || exit 1
echo "📦 electron-core-ui: typecheck"
pnpm run typecheck || exit 1
echo "📦 electron-core-ui: test"
pnpm run test || exit 1
echo "📦 electron-core-ui: build"
pnpm run build || exit 1
cd ..

# demo
echo "📦 demo: depcheck"
cd demo && npx depcheck || exit 1
echo "📦 demo: lint"
pnpm run lint || exit 1
echo "📦 demo: typecheck"
pnpm run typecheck || exit 1
echo "📦 demo: build"
pnpm run build || exit 1
cd ..

# restorm
echo "📦 restorm: depcheck"
cd restorm && npx depcheck || exit 1
echo "📦 restorm: lint"
pnpm run lint || exit 1
echo "📦 restorm: typecheck"
pnpm run typecheck || exit 1
echo "📦 restorm: unit tests"
pnpm run test:all || exit 1
echo "📦 restorm: build"
NODE_OPTIONS="--max-old-space-size=4096" pnpm run build || exit 1
cd ..

# NOTE: the full Playwright e2e suite is intentionally NOT run here. It is the
# heavy gate (~11-18 min, launches Electron instances) and lives at PUSH time
# (.husky/pre-push) instead, so commits stay fast and parallelizable. See
# scripts/ship.sh + .husky/README.md for the commit-fast / ship-gates-e2e flow.

echo "✅ All pre-commit checks passed!"
