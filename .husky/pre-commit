#!/bin/sh

echo "🔍 Running pre-commit checks..."

# STRICT MODE: Block eslint-disable and skipped tests
echo "🚫 Checking for forbidden patterns..."

# Check for eslint-disable (actual directives, not just comments mentioning it)
# Look for: /* eslint-disable or // eslint-disable or /* eslint-disable-next-line or // eslint-disable-next-line
if git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -E '(^|[^a-zA-Z])(\/\/|\/\*)\s*eslint-disable' 2>/dev/null; then
    echo "❌ BLOCKED: eslint-disable directives are STRICTLY FORBIDDEN!"
    echo ""
    echo "Files with eslint-disable directives:"
    git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -n -E '(^|[^a-zA-Z])(\/\/|\/\*)\s*eslint-disable' 2>/dev/null
    echo ""
    echo "⛔ Project rule: Fix the underlying issues instead of suppressing warnings."
    exit 1
fi

# Check for skipped tests
if git diff --cached --name-only | grep -E '\.test\.(ts|tsx|js|jsx)$' | xargs grep -l -E "(test\.skip|it\.skip|describe\.skip|xtest|xit|xdescribe)" 2>/dev/null; then
    echo "❌ BLOCKED: Skipped tests detected!"
    echo ""
    echo "Files with skipped tests:"
    git diff --cached --name-only | grep -E '\.test\.(ts|tsx|js|jsx)$' | xargs grep -n -E "(test\.skip|it\.skip|describe\.skip|xtest|xit|xdescribe)" 2>/dev/null
    echo ""
    echo "⛔ Project rule: All tests must be enabled and passing."
    exit 1
fi

echo "✅ No forbidden patterns found"
echo ""

# electron-core-ui
echo "📦 electron-core-ui: depcheck"
cd electron-core-ui && npx depcheck || exit 1
echo "📦 electron-core-ui: lint"
pnpm run lint || exit 1
echo "📦 electron-core-ui: typecheck"
pnpm run typecheck || exit 1
echo "📦 electron-core-ui: build"
pnpm run build || exit 1
cd ..

# gitable (disabled — not actively developed)
